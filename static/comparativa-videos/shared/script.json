  "cues": [
    {
      "start": 0,
      "end": 4.4,
      "text": "Un tiempo está entre cero y dos minutos con densidad constante de medio por minuto."
    },
    {
      "start": 4.7,
      "end": 8.5,
      "text": "¿Qué probabilidad queda entre cero coma cuatro y uno coma dos?"
    },
    {
      "start": 8.8,
      "end": 11.6,
      "text": "Primero restamos los límites para obtener la anchura."
    },
    {
      "start": 11.9,
      "end": 15.6,
      "text": "Ahora multiplicamos la altura medio por la anchura cero coma ocho."
    },
    {
      "start": 15.9,
      "end": 19.1,
      "text": "La franja sombreada tiene probabilidad cuatro décimas."
    },
    {
      "start": 19.4,
      "end": 22.5,
      "text": "Las unidades de tiempo y de tiempo inverso se cancelan."
    },
    {
      "start": 22.8,
      "end": 26,
      "text": "Si la altura cambia, usamos franjas más estrechas."
    },
    {
      "start": 26.3,
      "end": 31.7,
      "text": "La integral acumula sus aportaciones; el diferencial de te identifica la variable que recorre el tiempo."
    },
    {
      "start": 32,
      "end": 36.4,
      "text": "Si la regla cambia dentro del intervalo, separamos las integrales en esa frontera."
    },
    {
      "start": 36.7,
      "end": 39.5,
      "text": "No usamos una sola fórmula fuera de su tramo."
    }
  ],
