  "cues": [
    {
      "start": 0,
      "end": 1.6,
      "text": "Observamos equis cuarenta.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 1.9,
      "end": 3.9,
      "text": "¿Qué media condicional tiene i griega?",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 4.2,
      "end": 6.7,
      "text": "La distancia de equis a su media es diez.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 7,
      "end": 10.7,
      "text": "La pendiente condicional combina ro con la razón de desviaciones.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 11,
      "end": 13.8,
      "text": "Un cuarto por ocho entre cinco da cuatro décimas.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 14.1,
      "end": 19.1,
      "text": "Multiplicamos esa pendiente por la distancia diez; el desplazamiento esperado es cuatro.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 19.4,
      "end": 22.2,
      "text": "Sumamos cuatro a la media marginal setenta.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 22.5,
      "end": 25,
      "text": "La media condicional es setenta y cuatro.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 25.3,
      "end": 29.7,
      "text": "La varianza marginal sesenta y cuatro se multiplica por uno menos ro al cuadrado.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 30,
      "end": 31.6,
      "text": "El resultado es sesenta.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 31.9,
      "end": 37.3,
      "text": "Tomamos su raíz para tipificar: aproximadamente siete coma setecientos cuarenta y seis.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 37.6,
      "end": 41.4,
      "text": "La fórmula general reduce varianza, no desviación sin raíz.",
      "sectionId": "normal-bivariante--media-y-varianza-condicional"
    },
    {
      "start": 41.4,
      "end": 45.8,
      "text": "¿Qué probabilidad tiene i griega superar ochenta y dos cuando equis vale cuarenta?",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 46.1,
      "end": 50.2,
      "text": "La curva del corte es normal de media setenta y cuatro y varianza sesenta.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 50.5,
      "end": 52.4,
      "text": "Restamos la nueva media al umbral.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 52.7,
      "end": 53.9,
      "text": "La distancia es ocho.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 54.2,
      "end": 56.4,
      "text": "Dividimos ocho entre raíz de sesenta.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 56.7,
      "end": 60.099999999999994,
      "text": "Zeta es aproximadamente uno coma cero treinta y tres.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 60.4,
      "end": 62.599999999999994,
      "text": "La barra dice dado equis cuarenta.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 62.9,
      "end": 68.5,
      "text": "Esta probabilidad de superar ochenta y dos pertenece al corte conocido, no a la curva marginal.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 68.8,
      "end": 71.6,
      "text": "La calculamos complementando fi de ese zeta.",
      "sectionId": "normal-bivariante--cola-condicional"
    },
    {
      "start": 71.9,
      "end": 75.1,
      "text": "La cola es aproximadamente quince coma uno por ciento.",
      "sectionId": "normal-bivariante--cola-condicional"
    }
  ],
