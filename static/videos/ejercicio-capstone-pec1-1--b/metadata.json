          }
        ]
      },
      {
        "start": 126.43333333333334,
        "end": 135.2,
        "cues": [
          {
            "text": "Ponderar el resultado ampliado.",
            "start": 126.43333333333334,
            "end": 128.16666666666666,
            "startFrame": 3793,
            "endFrame": 3845,
            "words": 4,
            "sceneIndex": 10,
