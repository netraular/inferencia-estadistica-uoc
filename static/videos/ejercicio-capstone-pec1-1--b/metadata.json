          }
        ]
      },
      {
        "start": 77.96666666666667,
        "end": 84.7,
        "cues": [
          {
            "text": "Las identidades 1 y 2 se conservan; lunes puede corresponder a cualquiera de los dos.",
            "start": 77.96666666666667,
            "end": 84.4,
            "startFrame": 2339,
            "endFrame": 2532,
            "words": 15,
            "sceneIndex": 6,
