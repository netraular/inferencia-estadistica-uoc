        ]
      },
      {
        "start": 91.43333333333334,
        "end": 109.1,
        "cues": [
          {
            "text": "ese indica el descendiente elegido.",
            "start": 91.43333333333334,
            "end": 93.6,
            "startFrame": 2743,
            "endFrame": 2808,
            "words": 5,
            "sceneIndex": 8,
