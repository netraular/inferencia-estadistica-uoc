          },
          {
            "text": "La selección uniforme e independiente divide cada estado anterior en dos estados del mismo peso.",
            "start": 128.46666666666667,
            "end": 134.9,
            "startFrame": 3854,
            "endFrame": 4047,
            "words": 15,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "33ae44f51770f71f649192d50532c9cc77308ea7b6b2b1386b4feb75a1241859"
