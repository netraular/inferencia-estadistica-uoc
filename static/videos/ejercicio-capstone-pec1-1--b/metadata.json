        ]
      },
      {
        "start": 84.7,
        "end": 91.43333333333334,
        "cues": [
          {
            "text": "La elección ese del técnico es uniforme e independiente, anterior a observar genotipo y día.",
            "start": 84.7,
            "end": 91.13333333333334,
            "startFrame": 2541,
            "endFrame": 2734,
            "words": 15,
            "sceneIndex": 7,
            "cueIndex": 0,
