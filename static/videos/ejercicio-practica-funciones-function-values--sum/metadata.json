    "duration": 142.1,
    "scenes": [
      {
        "start": 0,
        "end": 15.933333333333334,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Cuánto vale ge abre paréntesis, 0, cierra paréntesis más ge abre paréntesis, 1, cierra paréntesis más ge abre paréntesis, 2, cierra paréntesis?",
            "start": 2.9,
            "end": 12.333333333333334,
            "startFrame": 87,
            "endFrame": 370,
            "words": 22,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "9b056862dc9560c240b6d38aff28600d73ce933a8a4aebd8dee59abe8cbf3e74"
          },
          {
            "text": "Queremos sumar varias salidas de la función.",
            "start": 12.633333333333333,
            "end": 15.633333333333333,
            "startFrame": 379,
            "endFrame": 469,
            "words": 7,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "fa58ebdf020db8097fa2976ea3b9cce15437ae2a34b95b0cf84be9c73d68563a"
          }
        ]
      },
      {
        "start": 15.933333333333334,
        "end": 32.733333333333334,
        "cues": [
          {
            "text": "La función asigna una salida a cada entrada del dominio.",
            "start": 15.933333333333334,
            "end": 20.233333333333334,
            "startFrame": 478,
            "endFrame": 607,
            "words": 10,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "a338e5b2d9476954f1cde6d934595fe9f9c76cb61e0b19b79c1ce7f7a2b1557e"
          },
          {
            "text": "Los paréntesis indican dónde sustituir la entrada.",
            "start": 20.533333333333335,
            "end": 23.533333333333335,
            "startFrame": 616,
            "endFrame": 706,
            "words": 7,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "59360a1fc880e4bba65eb49a2d421a935dc2fc62aa032d592425e700aaca79fe"
          },
          {
            "text": "Multiplicamos antes de sumar y respetamos los extremos del dominio; sumar salidas es distinto de evaluar la suma de entradas.",
            "start": 23.833333333333332,
            "end": 32.43333333333333,
            "startFrame": 715,
            "endFrame": 973,
            "words": 20,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "4761eeed1aec1e3729bcc123a27d6effce46a869dc2d97a94ede5093d09ecf52"
          }
        ]
      },
      {
        "start": 32.733333333333334,
        "end": 39.46666666666667,
        "cues": [
          {
            "text": "ge abre paréntesis, equis minúscula, cierra paréntesis igual a 4 por equis minúscula más 5.",
            "start": 32.733333333333334,
            "end": 39.166666666666664,
            "startFrame": 982,
            "endFrame": 1175,
            "words": 15,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "93db36128a5bfd5a6229589d6a5139ebb3a61668c42d46466497162ee1a13485"
          }
        ]
      },
      {
        "start": 39.46666666666667,
        "end": 47.93333333333333,
        "cues": [
          {
            "text": "Se permiten entradas equis minúscula entre 0 y 3, incluidos ambos extremos; entrada pedida: equis minúscula igual a 1.",
            "start": 39.46666666666667,
            "end": 47.63333333333333,
            "startFrame": 1184,
            "endFrame": 1429,
            "words": 19,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "4d8b207e5259703f6f77941a8d0d79d87eae8ea783b9294487116a3810e64ca2"
          }
        ]
      },
      {
        "start": 47.93333333333333,
        "end": 51.666666666666664,
        "cues": [
          {
            "text": "Los paréntesis indican la entrada de la función.",
            "start": 47.93333333333333,
            "end": 51.36666666666667,
            "startFrame": 1438,
            "endFrame": 1541,
            "words": 8,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "8fae598c37239631923a221271416a737883c5a9d0d984b66fc4a9581afdd3f5"
          }
        ]
      },
      {
        "start": 51.666666666666664,
        "end": 55.4,
        "cues": [
          {
            "text": "Sumar salidas no significa sumar únicamente sus entradas.",
            "start": 51.666666666666664,
            "end": 55.1,
            "startFrame": 1550,
            "endFrame": 1653,
            "words": 8,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "83108a70a56a79a17adb8ed37ebe0178ddfff7fd5492b22a7228e336941c0358"
          }
        ]
      },
      {
        "start": 55.4,
        "end": 65.03333333333333,
        "cues": [
          {
            "text": "Calcula las tres salidas por separado.",
            "start": 55.4,
            "end": 58,
            "startFrame": 1662,
            "endFrame": 1740,
            "words": 6,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "788e071993747dda105ba0aaa1e00574844f7df241c4a366e42ea7292aa3facf"
          },
          {
            "text": "Evaluamos cada entrada antes de sumar; evaluar solo la suma de entradas sería otra operación.",
            "start": 58.3,
            "end": 64.73333333333333,
            "startFrame": 1749,
            "endFrame": 1942,
            "words": 15,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "5f23ebdfd6daca5724874c21f467be3050823ae4a5c092fc93be19a2f5149658"
          }
        ]
      },
      {
        "start": 65.03333333333333,
        "end": 95.6,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 65.03333333333333,
            "end": 68.03333333333333,
            "startFrame": 1951,
            "endFrame": 2041,
            "words": 7,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "a3a9facd0d7e0e39df126691d21c1de17e3b3772c883acb32c3f895204dd4e94"
          },
          {
            "text": "¿Cuánto vale ge abre paréntesis, 0, cierra paréntesis más ge abre paréntesis, 1, cierra paréntesis más ge abre paréntesis, 2, cierra paréntesis?",
            "start": 68.33333333333333,
            "end": 77.76666666666667,
            "startFrame": 2050,
            "endFrame": 2333,
            "words": 22,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "42c0a26392d8ff97cd72104c5c4b882b0193552a0ffcc455b2ff0783e0057ab0"
          },
          {
            "text": "Una función es una regla de entrada y salida.",
            "start": 78.06666666666666,
            "end": 81.93333333333334,
            "startFrame": 2342,
            "endFrame": 2458,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "cddde47cfcc1ca8b7b59b40377f8c3684d08d059f7d2da52b385aeb91133c54f"
          },
          {
            "text": "Primero localizamos la entrada permitida; después la sustituimos en la regla.",
            "start": 82.23333333333333,
            "end": 86.96666666666667,
            "startFrame": 2467,
            "endFrame": 2609,
            "words": 11,
            "sceneIndex": 7,
            "cueIndex": 3,
            "sourceCueSha256": "405973c4631d1cb258cb56c39c1ebb12b4d604b99d49b1ffd619ffe1c26e8a09"
          },
          {
            "text": "Un sumatorio solo abrevia sumar varias de esas salidas.",
            "start": 87.26666666666667,
            "end": 91.13333333333334,
            "startFrame": 2618,
            "endFrame": 2734,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 4,
            "sourceCueSha256": "b535e056faf89aeb4e38560f8467beaadc76082bf62ec089404e346cb24efcd4"
          },
          {
            "text": "Para este apartado: Calcula las tres salidas por separado.",
            "start": 91.43333333333334,
            "end": 95.3,
            "startFrame": 2743,
            "endFrame": 2859,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 5,
            "sourceCueSha256": "5902bbd6038baeb140e2cec31a95056517ae8d3abb4dd9ba3919cb00fc997009"
          }
        ]
      },
      {
        "start": 95.6,
        "end": 108.76666666666667,
        "cues": [
          {
            "text": "Abrir la suma. ge abre paréntesis, 0, cierra paréntesis igual a 5; ge abre paréntesis, 1, cierra paréntesis igual a 9; ge abre paréntesis, 2, cierra paréntesis igual a 13.",
            "start": 95.6,
            "end": 108.46666666666667,
            "startFrame": 2868,
            "endFrame": 3254,
            "words": 30,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "8bc7d3ef318526f5463264d932d4321d0369ec0a29aed9192462b3d5f379a5a4"
          }
        ]
      },
      {
        "start": 108.76666666666667,
        "end": 119.26666666666667,
        "cues": [
          {
            "text": "Sumar los resultados. 5 más 9 más 13 igual a 27.",
            "start": 108.76666666666667,
            "end": 113.5,
            "startFrame": 3263,
            "endFrame": 3405,
            "words": 11,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "b463f57c41f2ec4b10db9f11905f14aab95eca2d0d550d36912de641030f100a"
          },
          {
            "text": "Un sumatorio con índices 0, 1 y 2 abreviaría esta misma cuenta.",
            "start": 113.8,
            "end": 118.96666666666667,
            "startFrame": 3414,
            "endFrame": 3569,
            "words": 12,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "13cb1c617fc2d68171c9312f10fee34fa44b8447b2009b9dfdf88289b6cf266a"
          }
        ]
      },
      {
        "start": 119.26666666666667,
        "end": 134.63333333333333,
        "cues": [
          {
            "text": "Comprobar e interpretar.",
            "start": 119.26666666666667,
            "end": 120.56666666666666,
            "startFrame": 3578,
            "endFrame": 3617,
            "words": 3,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "cf55d2dee61fecaefaf517d976559bb39558cb6d8cca4785a5a69cdccecd549a"
          },
          {
            "text": "El resultado es 27 unidades de señal.",
            "start": 120.86666666666666,
            "end": 123.86666666666666,
            "startFrame": 3626,
            "endFrame": 3716,
            "words": 7,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "580357a598bc62df2064380b4739c72aa178b0854fb1169374dedd713a52142b"
          },
          {
            "text": "Revisamos que la respuesta use la unidad pedida y tenga sentido en el contexto.",
            "start": 124.16666666666667,
            "end": 130.16666666666666,
            "startFrame": 3725,
            "endFrame": 3905,
            "words": 14,
            "sceneIndex": 10,
            "cueIndex": 2,
            "sourceCueSha256": "4359d019282d11c360f5c6605577a4cca1a601f2e439655d7b5fdcb0af659a85"
          },
          {
            "text": "El índice indica qué entrada usar en cada término.",
            "start": 130.46666666666667,
            "end": 134.33333333333334,
            "startFrame": 3914,
            "endFrame": 4030,
            "words": 9,
            "sceneIndex": 10,
            "cueIndex": 3,
            "sourceCueSha256": "aa46897130e113fc5314b00a3025a8c3654d740261035558f2996ed265a83a0a"
          }
        ]
