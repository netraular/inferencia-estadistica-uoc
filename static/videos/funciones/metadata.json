          }
        ]
      },
      {
        "start": 416.3666666666667,
        "end": 423.8333333333333,
        "cues": [
          {
            "text": "El resultado es 24 unidades de señal.",
            "start": 416.3666666666667,
            "end": 419.3666666666667,
            "startFrame": 12491,
