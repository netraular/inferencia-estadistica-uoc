          }
        ]
      },
      {
        "start": 53.9,
        "end": 79.46666666666667,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 53.9,
            "end": 56.9,
            "startFrame": 1617,
            "endFrame": 1707,
            "words": 7,
            "sceneIndex": 7,
            "cueIndex": 0,
