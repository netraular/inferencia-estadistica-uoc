          },
          {
            "text": "Para este apartado: Ahora el denominador son todas las plantas recuperadas.",
            "start": 74.43333333333334,
            "end": 79.16666666666667,
            "startFrame": 2233,
            "endFrame": 2375,
            "words": 11,
            "sceneIndex": 7,
            "cueIndex": 4,
            "sourceCueSha256": "50353198212dd44bbec3bd6b4329bd166265670ff39d57bf1ed52bb9c395de4a"
          }
        ]
      },
      {
        "start": 79.46666666666667,
        "end": 83.63333333333334,
        "cues": [
          {
            "text": "Contar las recuperadas. 32 más 18 igual a 50.",
            "start": 79.46666666666667,
            "end": 83.33333333333333,
            "startFrame": 2384,
            "endFrame": 2500,
            "words": 9,
