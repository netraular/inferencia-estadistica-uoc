    "duration": 123.7,
    "scenes": [
      {
        "start": 0,
        "end": 11.7,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Qué proporción de las semillas germinó?",
            "start": 2.9,
            "end": 5.5,
            "startFrame": 87,
            "endFrame": 165,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "321788c6aa3471d2dc00b96edfabef9c8ae32a155d63e79726b2661a5b38043f"
          },
          {
            "text": "Queremos comparar una parte con su propio total, no dar un recuento absoluto.",
            "start": 5.8,
            "end": 11.4,
            "startFrame": 174,
            "endFrame": 342,
            "words": 13,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "9d2d003a9fbe3398290d4830e52597de26915937790ca622e4322f780303f799"
          }
        ]
      },
      {
        "start": 11.7,
        "end": 26.766666666666666,
        "cues": [
          {
            "text": "Una proporción divide la parte por el total al que pertenece.",
            "start": 11.7,
            "end": 16.433333333333334,
            "startFrame": 351,
            "endFrame": 493,
            "words": 11,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "7afcb52b5a25efc34290b9b5455e104973d1f4261e18072295a66eb7ec8ecb4d"
          },
          {
            "text": "El porcentaje multiplica esa proporción por cien.",
            "start": 16.733333333333334,
            "end": 19.733333333333334,
            "startFrame": 502,
            "endFrame": 592,
            "words": 7,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "56aba128c1e151c16e02f1e012a0db5e9143592207a46858797e4d5f066e8b35"
          },
          {
            "text": "Para cambiar unidades multiplicamos por una equivalencia que vale uno físicamente, conservando la cantidad medida.",
            "start": 20.033333333333335,
            "end": 26.466666666666665,
            "startFrame": 601,
            "endFrame": 794,
            "words": 15,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "7f516cc3357456e9ec56eab10cbf14395048b4bb8b9635572fab4cf320563de7"
          }
        ]
      },
      {
        "start": 26.766666666666666,
        "end": 30.066666666666666,
        "cues": [
          {
            "text": "Se siembran 40 semillas y germinan 20.",
            "start": 26.766666666666666,
            "end": 29.766666666666666,
            "startFrame": 803,
            "endFrame": 893,
            "words": 7,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "857a6ddbeb0be1ab7f3dce1b32b55af6b475c74b29a953027cfa71b84964afac"
          }
        ]
      },
      {
        "start": 30.066666666666666,
        "end": 35.1,
        "cues": [
          {
            "text": "Se pesan 2 miligramos de nutriente; un miligramo contiene 1000 microgramos.",
            "start": 30.066666666666666,
            "end": 34.8,
            "startFrame": 902,
            "endFrame": 1044,
            "words": 11,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "379c3edc6e8957a3aa84f8a314b1ee47edf96f3411161b22abf7f53b032364de"
          }
        ]
      },
      {
        "start": 35.1,
        "end": 38.833333333333336,
        "cues": [
          {
            "text": "Las semillas germinadas forman parte de las sembradas.",
            "start": 35.1,
            "end": 38.53333333333333,
            "startFrame": 1053,
            "endFrame": 1156,
            "words": 8,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "fb621b158505dab3f1e2e802851ae1dd5e1e2f0296ae44a31545cf61695e57cc"
          }
        ]
      },
      {
        "start": 38.833333333333336,
        "end": 43.86666666666667,
        "cues": [
          {
            "text": "Cambiar la unidad de masa no cambia la cantidad de nutriente.",
            "start": 38.833333333333336,
            "end": 43.56666666666667,
            "startFrame": 1165,
            "endFrame": 1307,
            "words": 11,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "b11666d22980529273834164eb23afbda16ef0c0d14a311be62eecb131275daa"
          }
        ]
      },
      {
        "start": 43.86666666666667,
        "end": 52.2,
        "cues": [
          {
            "text": "El total son todas las semillas sembradas.",
            "start": 43.86666666666667,
            "end": 46.86666666666667,
            "startFrame": 1316,
            "endFrame": 1406,
            "words": 7,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "0a7ccdf454016925ed4e43a0b677310488e69aafb81afba1f810133b27d0e537"
          },
          {
            "text": "Dividir por el total conserva la importancia relativa de esa parte.",
            "start": 47.166666666666664,
            "end": 51.9,
            "startFrame": 1415,
            "endFrame": 1557,
            "words": 11,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "84781d3bb90edc21ae445a3f33e961f5b9a6a159d4173fbeb141f65dec2473cb"
          }
        ]
      },
      {
        "start": 52.2,
        "end": 77.23333333333333,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 52.2,
            "end": 55.2,
            "startFrame": 1566,
            "endFrame": 1656,
            "words": 7,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "a3a9facd0d7e0e39df126691d21c1de17e3b3772c883acb32c3f895204dd4e94"
          },
          {
            "text": "¿Qué proporción de las semillas germinó?",
            "start": 55.5,
            "end": 58.1,
            "startFrame": 1665,
            "endFrame": 1743,
            "words": 6,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "1d48c3c7005bfb580c5467928dca1d92199cdf68ed2e2af74adc772a888305af"
          },
          {
            "text": "Una proporción compara una parte con su propio total.",
            "start": 58.4,
            "end": 62.266666666666666,
            "startFrame": 1752,
            "endFrame": 1868,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "1c321ce65f0e7c974103cbe5cb7f12f4862997561df1f9fb58ef30d0f105e399"
          },
          {
            "text": "Dividir conserva la comparación; multiplicar por cien solo cambia su escritura a porcentaje.",
            "start": 62.56666666666667,
            "end": 68.16666666666667,
            "startFrame": 1877,
            "endFrame": 2045,
            "words": 13,
            "sceneIndex": 7,
            "cueIndex": 3,
            "sourceCueSha256": "2fa79a28862a4803f98a8ada7469d9a23d0d522a1139636558a9d8201f14971a"
          },
          {
            "text": "En una conversión de unidades conservamos la cantidad física.",
            "start": 68.46666666666667,
            "end": 72.33333333333333,
            "startFrame": 2054,
            "endFrame": 2170,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 4,
            "sourceCueSha256": "f4f0d78b4c76530c08c8bf7fcaccb8290e3ceb6c60e6fa5df58af206540ec5da"
          },
          {
            "text": "Para este apartado: El total son todas las semillas sembradas.",
            "start": 72.63333333333334,
            "end": 76.93333333333334,
            "startFrame": 2179,
            "endFrame": 2308,
            "words": 10,
            "sceneIndex": 7,
            "cueIndex": 5,
            "sourceCueSha256": "f3cb961bf657eaca36453cc95769b2be26a4f021440fd86a79421de8c34229cd"
          }
        ]
      },
      {
        "start": 77.23333333333333,
        "end": 84.73333333333333,
        "cues": [
          {
            "text": "Nombrar parte y total.",
            "start": 77.23333333333333,
            "end": 78.96666666666667,
            "startFrame": 2317,
            "endFrame": 2369,
            "words": 4,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "ac3d3e76404003971d7c9e0c75ad93c62285aa0a502457b969acb605d45b6fc8"
          },
          {
            "text": "La parte son 20 semillas germinadas y el total son 40 sembradas.",
            "start": 79.26666666666667,
            "end": 84.43333333333334,
            "startFrame": 2378,
            "endFrame": 2533,
            "words": 12,
            "sceneIndex": 8,
            "cueIndex": 1,
            "sourceCueSha256": "6e329d5213b771640729b32a3ca165a73f5776667a116b335a4ce4f02d679e45"
          }
        ]
      },
      {
        "start": 84.73333333333333,
        "end": 95.23333333333333,
        "cues": [
          {
            "text": "Dividir. 20 dividido entre 40 igual a 0 coma 5.",
            "start": 84.73333333333333,
            "end": 89.03333333333333,
            "startFrame": 2542,
            "endFrame": 2671,
            "words": 10,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "581bd1505a31ee13389d129a601f2ba65aed13a8a2e084629051d88b5a4a8a37"
          },
          {
            "text": "De cada cien semillas, la misma proporción equivale a 50: 50 por ciento.",
            "start": 89.33333333333333,
            "end": 94.93333333333334,
            "startFrame": 2680,
            "endFrame": 2848,
            "words": 13,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "8526d681a93069d8fbd881a522c62a8b10dd5968ca5881ca38119ddf62f14697"
          }
        ]
      },
      {
        "start": 95.23333333333333,
        "end": 114.06666666666666,
        "cues": [
          {
            "text": "Comprobar e interpretar.",
            "start": 95.23333333333333,
            "end": 96.53333333333333,
            "startFrame": 2857,
            "endFrame": 2896,
            "words": 3,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "cf55d2dee61fecaefaf517d976559bb39558cb6d8cca4785a5a69cdccecd549a"
          },
          {
            "text": "El resultado es 0 coma 5 probabilidad entre 0 y 1.",
            "start": 96.83333333333333,
            "end": 101.56666666666666,
            "startFrame": 2905,
            "endFrame": 3047,
            "words": 11,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "50c6c5d1bad50ec3564511709f31053bd27c5f4d66de128356fc0db0e8e1f1cf"
          },
          {
            "text": "Está entre cero y uno; si lo expresamos como porcentaje multiplicamos por cien, sin cambiar el suceso.",
            "start": 101.86666666666666,
            "end": 109.16666666666667,
            "startFrame": 3056,
            "endFrame": 3275,
            "words": 17,
            "sceneIndex": 10,
            "cueIndex": 2,
            "sourceCueSha256": "aee7aa7f459227fe3169942c310bf051d5daefa61d107ed0999c163ee69af9ca"
          },
          {
            "text": "La proporción permite comparar ensayos con distinto número de semillas.",
            "start": 109.46666666666667,
            "end": 113.76666666666667,
            "startFrame": 3284,
            "endFrame": 3413,
            "words": 10,
            "sceneIndex": 10,
            "cueIndex": 3,
            "sourceCueSha256": "b6fff63eb9e0dcdece0c30d3ae38575c8b1d4167208bb64c43be09347b5e15ad"
          }
        ]
      },
      {
        "start": 114.06666666666666,
        "end": 123.7,
        "cues": [
