    "temporary": true,
    "silent": true,
    "canonicalSha256": "43d8e9ecfb80bebdfd81aa55f3db38da42cefb4c58dee0b72f6f0e01f0ac1f59",
    "timing": {
      "wordsPerMinute": 140,
