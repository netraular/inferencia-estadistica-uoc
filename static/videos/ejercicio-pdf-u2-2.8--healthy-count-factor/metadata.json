          }
        ]
      },
      {
        "start": 75.33333333333333,
        "end": 81.23333333333333,
        "cues": [
          {
            "text": "El 2 por ciento es la cola inferior de diabéticos, no la superior.",
            "start": 75.33333333333333,
            "end": 80.93333333333334,
            "startFrame": 2260,
            "endFrame": 2428,
            "words": 13,
            "sceneIndex": 6,
