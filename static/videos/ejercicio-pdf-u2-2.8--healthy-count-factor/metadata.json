            "endFrame": 354,
            "words": 7,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "3a95a563b8f5f79934fcf1a793881d20c44a25f50f1011f465b0d05a8b9b3360"
          },
          {
            "text": "Queremos cuantificar errores entre las personas sanas.",
