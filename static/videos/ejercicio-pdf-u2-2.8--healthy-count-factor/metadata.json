        ]
      },
      {
        "start": 71.6,
        "end": 75.33333333333333,
        "cues": [
          {
            "text": "Los grupos sano y diabético forman una partición.",
            "start": 71.6,
            "end": 75.03333333333333,
            "startFrame": 2148,
            "endFrame": 2251,
            "words": 8,
