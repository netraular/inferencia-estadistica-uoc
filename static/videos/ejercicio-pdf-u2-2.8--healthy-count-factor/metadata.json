            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "Expresa el número de sanos mal clasificados como función de ene mayúscula sanos.",
            "start": 2.9,
            "end": 8.5,
            "startFrame": 87,
            "endFrame": 255,
            "words": 13,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "a0d48e02537d85ffb020603c515b0c5bc33b80e9319b849512182cf8b50d0965"
          },
          {
            "text": "Introduce el factor que multiplica ene mayúscula.",
