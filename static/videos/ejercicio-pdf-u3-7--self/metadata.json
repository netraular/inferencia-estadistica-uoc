    "duration": 127.9,
    "scenes": [
      {
        "start": 0,
        "end": 12.533333333333333,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Cuánto vale covarianza de i griega subíndice 1 y i griega subíndice 1?",
            "start": 2.9,
            "end": 8.5,
            "startFrame": 87,
            "endFrame": 255,
            "words": 13,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "941405b230c2d2b112bbd9bec691da1ced9154a69ca2ee8a0b3cf0491534e807"
          },
          {
            "text": "Queremos la covarianza de una variable consigo misma.",
            "start": 8.8,
            "end": 12.233333333333333,
            "startFrame": 264,
            "endFrame": 367,
            "words": 8,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "2a3c9ef00dfd0f61dc34062fca705e1533c3ba3a8e153bb242bb0e7881b6f642"
          }
        ]
      },
      {
        "start": 12.533333333333333,
        "end": 30.166666666666668,
        "cues": [
          {
            "text": "La covarianza es la esperanza del producto de las desviaciones respecto a las medias.",
            "start": 12.533333333333333,
            "end": 18.533333333333335,
            "startFrame": 376,
            "endFrame": 556,
            "words": 14,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "b39e2810a077a18227c868732906dbf70c19784ba5fc55eb0e5d1af3b2a657c1"
          },
          {
            "text": "Desarrollar ese producto da esperanza del producto menos producto de medias.",
            "start": 18.833333333333332,
            "end": 23.566666666666666,
            "startFrame": 565,
            "endFrame": 707,
            "words": 11,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "8e0dfaba82469a1d895ee5707c712dd27b3535a1b2b7658934903b541009c469"
          },
          {
            "text": "La correlación divide por ambas desviaciones positivas y elimina las unidades; no demuestra causalidad.",
            "start": 23.866666666666667,
            "end": 29.866666666666667,
            "startFrame": 716,
            "endFrame": 896,
            "words": 14,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "5d200402079f3ee8f4daaaf8e3e04a5ff134d488ce132653ffa859e0574dcabe"
          }
        ]
      },
      {
        "start": 30.166666666666668,
        "end": 46.333333333333336,
        "cues": [
          {
            "text": "esperanza de i griega subíndice 1 igual a 4; esperanza de i griega subíndice 2 igual a menos 1; varianza de i griega subíndice 1 igual a 2; varianza de i griega subíndice 2 igual a 8.",
            "start": 30.166666666666668,
            "end": 46.03333333333333,
            "startFrame": 905,
            "endFrame": 1381,
            "words": 37,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "5cc291ee141f1fef5ef801ba42d83df749d3dc26e2a0e0486d6ea4bb0bca358c"
          }
        ]
      },
      {
        "start": 46.333333333333336,
        "end": 56.93333333333333,
        "cues": [
          {
            "text": "Se propone covarianza de i griega subíndice 1 y i griega subíndice 2 igual a 7 y se pide también la mayor covarianza posible.",
            "start": 46.333333333333336,
            "end": 56.63333333333333,
            "startFrame": 1390,
            "endFrame": 1699,
            "words": 24,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "17fc4b181a8a7304f615622347c8488738b03d280ab1bdbbbb74642ebd270da5"
          }
        ]
      },
      {
        "start": 56.93333333333333,
        "end": 61.53333333333333,
        "cues": [
          {
            "text": "Se suponen momentos finitos y las dos varianzas positivas dadas.",
            "start": 56.93333333333333,
            "end": 61.233333333333334,
            "startFrame": 1708,
            "endFrame": 1837,
            "words": 10,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "b6ef39f98fc8509344b41da02d538b085fbbfdeb7319974606719e7293f33bf0"
          }
        ]
      },
      {
        "start": 61.53333333333333,
        "end": 75.76666666666667,
        "cues": [
          {
            "text": "El producto centrado consigo misma es un cuadrado.",
            "start": 61.53333333333333,
            "end": 64.96666666666667,
            "startFrame": 1846,
            "endFrame": 1949,
            "words": 8,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "2a688cf2b12790837f012bb3df3419e44f303b84132aabc38fab4fc083c6718a"
          },
          {
            "text": "Su esperanza es precisamente la varianza.",
            "start": 65.26666666666667,
            "end": 67.86666666666666,
            "startFrame": 1958,
            "endFrame": 2036,
            "words": 6,
            "sceneIndex": 5,
            "cueIndex": 1,
            "sourceCueSha256": "8db5a429a7a04f838f931053f8d67c8b894ac91b9fa1cd68ce421ea87e23d8ea"
          },
          {
            "text": "El producto de sus dos desviaciones es el cuadrado de la desviación; su esperanza es la varianza.",
            "start": 68.16666666666667,
            "end": 75.46666666666667,
            "startFrame": 2045,
            "endFrame": 2264,
            "words": 17,
            "sceneIndex": 5,
            "cueIndex": 2,
            "sourceCueSha256": "41006f4bb71eb55fd9ef0da390a6ef7846541e90560c760afecd1ecf1aa1f54d"
          }
        ]
      },
      {
        "start": 75.76666666666667,
        "end": 86.26666666666667,
        "cues": [
          {
            "text": "E entre corchetes significa esperanza.",
            "start": 75.76666666666667,
            "end": 77.93333333333334,
            "startFrame": 2273,
            "endFrame": 2338,
            "words": 5,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "10cad504a3b8006d58ad81bbf2197dce3d8c86e7c1892dd103cef938488fff2b"
          },
          {
            "text": "Si dentro hay un producto o un cuadrado, se realiza esa operación en cada resultado antes de ponderar.",
            "start": 78.23333333333333,
            "end": 85.96666666666667,
            "startFrame": 2347,
            "endFrame": 2579,
            "words": 18,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "d8b0e6615c93ba842492ade70b4ca63e012d8cf67ec3c069e6f1444d1244b964"
          }
        ]
      },
      {
        "start": 86.26666666666667,
        "end": 110.23333333333333,
        "cues": [
          {
            "text": "Una variable consigo misma.",
            "start": 86.26666666666667,
            "end": 88,
            "startFrame": 2588,
            "endFrame": 2640,
            "words": 4,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "fd9cca611311b3d975f17f0535391304d765179ed6abccae29c54ccb3a66de8b"
          },
          {
            "text": "El producto centrado consigo misma es un cuadrado.",
            "start": 88.3,
            "end": 91.73333333333333,
            "startFrame": 2649,
            "endFrame": 2752,
            "words": 8,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "f9bc24ac0da0ac0be5df6a014a9d0f3076b19f3e838cff5e760f05b359f0bbcc"
          },
          {
            "text": "Su esperanza es precisamente la varianza.",
            "start": 92.03333333333333,
            "end": 94.63333333333334,
            "startFrame": 2761,
            "endFrame": 2839,
            "words": 6,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "01f59b925c933676890c3432f8cd71a310ae304f14f6fe87e713f46de4a698fb"
          },
          {
            "text": "Cov abre paréntesis, i griega subíndice 1 y i griega subíndice 1, cierra paréntesis igual a esperanza de abre corchete, abre paréntesis, i griega subíndice 1 menos 4, cierra paréntesis al cuadrado , cierra corchete.",
            "start": 94.93333333333334,
            "end": 109.93333333333334,
            "startFrame": 2848,
            "endFrame": 3298,
            "words": 35,
            "sceneIndex": 7,
            "cueIndex": 3,
            "sourceCueSha256": "06f6bac46f07096ad4ea50281b33a4ca7cf22ee8d4a011eadf8d4dc8945f2712"
          }
        ]
      },
      {
        "start": 110.23333333333333,
        "end": 118.26666666666667,
        "cues": [
          {
            "text": "Cov abre paréntesis, i griega subíndice 1 y i griega subíndice 1, cierra paréntesis queda igual a 2.",
            "start": 110.23333333333333,
            "end": 117.96666666666667,
            "startFrame": 3307,
            "endFrame": 3539,
            "words": 18,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "4735b51e7a3b41c41fbe867cb5f6348271c3a80e376f93c1b7f592d243cc82f6"
          }
        ]
      },
      {
        "start": 118.26666666666667,
        "end": 127.9,
        "cues": [
          {
            "text": "El resultado es 2 unidades de i griega subíndice 1 al cuadrado.",
            "start": 118.26666666666667,
            "end": 123.43333333333334,
            "startFrame": 3548,
            "endFrame": 3703,
            "words": 12,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "d81a17577c25889b23a6009864ad4c559469bc6b84480ab2fbdc93365e59123a"
          },
          {
            "text": "La diagonal de una matriz de covarianzas contiene varianzas.",
            "start": 123.73333333333333,
            "end": 127.6,
            "startFrame": 3712,
            "endFrame": 3828,
            "words": 9,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "150dc489de12aa8bf8031c889f19f34af23422567a03aedfd6e4d0ba6f55f4dd"
          }
        ]
      }
