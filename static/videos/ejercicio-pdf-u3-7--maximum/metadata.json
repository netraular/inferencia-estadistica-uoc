    },
    "duration": 123.16666666666667,
    "scenes": [
      {
        "start": 0,
        "end": 9.966666666666667,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Cuál es la mayor covarianza posible?",
            "start": 2.9,
            "end": 5.5,
            "startFrame": 87,
            "endFrame": 165,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "f38987491395d330581b6ba3ac50f768ce87ad30b062899c8325ae778d280fc1"
          },
          {
            "text": "Queremos la mayor covarianza compatible con las dos varianzas.",
            "start": 5.8,
            "end": 9.666666666666666,
            "startFrame": 174,
            "endFrame": 290,
            "words": 9,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "f79c5545be014e8afb0f92ecf1ad20e5c5d073bd85bd07be4db675b32fe05ad4"
          }
        ]
      },
      {
        "start": 9.966666666666667,
        "end": 27.6,
        "cues": [
          {
            "text": "La covarianza es la esperanza del producto de las desviaciones respecto a las medias.",
            "start": 9.966666666666667,
            "end": 15.966666666666667,
            "startFrame": 299,
            "endFrame": 479,
            "words": 14,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "b39e2810a077a18227c868732906dbf70c19784ba5fc55eb0e5d1af3b2a657c1"
          },
          {
            "text": "Desarrollar ese producto da esperanza del producto menos producto de medias.",
            "start": 16.266666666666666,
            "end": 21,
            "startFrame": 488,
            "endFrame": 630,
            "words": 11,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "8e0dfaba82469a1d895ee5707c712dd27b3535a1b2b7658934903b541009c469"
          },
          {
            "text": "La correlación divide por ambas desviaciones positivas y elimina las unidades; no demuestra causalidad.",
            "start": 21.3,
            "end": 27.3,
            "startFrame": 639,
            "endFrame": 819,
            "words": 14,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "5d200402079f3ee8f4daaaf8e3e04a5ff134d488ce132653ffa859e0574dcabe"
          }
        ]
      },
      {
        "start": 27.6,
        "end": 43.766666666666666,
        "cues": [
          {
            "text": "esperanza de i griega subíndice 1 igual a 4; esperanza de i griega subíndice 2 igual a menos 1; varianza de i griega subíndice 1 igual a 2; varianza de i griega subíndice 2 igual a 8.",
            "start": 27.6,
            "end": 43.46666666666667,
            "startFrame": 828,
            "endFrame": 1304,
            "words": 37,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "5cc291ee141f1fef5ef801ba42d83df749d3dc26e2a0e0486d6ea4bb0bca358c"
          }
        ]
      },
      {
        "start": 43.766666666666666,
        "end": 54.36666666666667,
        "cues": [
          {
            "text": "Se propone covarianza de i griega subíndice 1 y i griega subíndice 2 igual a 7 y se pide también la mayor covarianza posible.",
            "start": 43.766666666666666,
            "end": 54.06666666666667,
            "startFrame": 1313,
            "endFrame": 1622,
            "words": 24,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "17fc4b181a8a7304f615622347c8488738b03d280ab1bdbbbb74642ebd270da5"
          }
        ]
      },
      {
        "start": 54.36666666666667,
        "end": 58.96666666666667,
        "cues": [
          {
            "text": "Se suponen momentos finitos y las dos varianzas positivas dadas.",
            "start": 54.36666666666667,
            "end": 58.666666666666664,
            "startFrame": 1631,
            "endFrame": 1760,
            "words": 10,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "b6ef39f98fc8509344b41da02d538b085fbbfdeb7319974606719e7293f33bf0"
          }
        ]
      },
      {
        "start": 58.96666666666667,
        "end": 71.56666666666666,
        "cues": [
          {
            "text": "Cauchy y Schwarz limitan la magnitud de la covarianza al producto de las desviaciones.",
            "start": 58.96666666666667,
            "end": 64.96666666666667,
            "startFrame": 1769,
            "endFrame": 1949,
            "words": 14,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "0b5039b7bb36a4fb5ccf797f16d77f252d5ea351a16545a5f463b2681608c4fa"
          },
          {
            "text": "La desigualdad de Cauchy y Schwarz limita su magnitud al producto de las desviaciones.",
            "start": 65.26666666666667,
            "end": 71.26666666666667,
            "startFrame": 1958,
            "endFrame": 2138,
            "words": 14,
            "sceneIndex": 5,
            "cueIndex": 1,
            "sourceCueSha256": "17fd4e9f183f429ac2ec974b79421b6d6dc0aa74e5d4ccdbc55595060cd5d72e"
          }
        ]
      },
      {
        "start": 71.56666666666666,
        "end": 92.76666666666667,
        "cues": [
          {
            "text": "Aplicar la cota.",
            "start": 71.56666666666666,
            "end": 72.86666666666666,
            "startFrame": 2147,
            "endFrame": 2186,
            "words": 3,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "2d7f6e7d76ae92fdc109750acf3388f196b9a71ccd97f82c6d7980bdc6363b2d"
          },
          {
            "text": "Cauchy y Schwarz limitan la magnitud de la covarianza al producto de las desviaciones. sabiendo que Cov abre paréntesis, i griega subíndice 1 y i griega subíndice 2, cierra paréntesis sabiendo que menor o igual que raíz de abre paréntesis, 2 por 8, cierra paréntesis.",
            "start": 73.16666666666667,
            "end": 92.46666666666667,
            "startFrame": 2195,
            "endFrame": 2774,
            "words": 45,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "566076dd3512e7009e3c1d0c5f159e7d88a1646c0b6e518f92875b24e4f1bac8"
          }
        ]
      },
      {
        "start": 92.76666666666667,
        "end": 106.26666666666667,
        "cues": [
          {
            "text": "Evaluar el máximo.",
            "start": 92.76666666666667,
            "end": 94.06666666666666,
            "startFrame": 2783,
            "endFrame": 2822,
            "words": 3,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "027a3f50e961586f43161a71e926d6a59ebc2e2ba91be67349f1262f10288dc7"
          },
          {
            "text": "El extremo positivo corresponde a rho igual a uno. máximo Cov abre paréntesis, i griega subíndice 1 y i griega subíndice 2, cierra paréntesis igual a 4.",
            "start": 94.36666666666666,
            "end": 105.96666666666667,
            "startFrame": 2831,
            "endFrame": 3179,
            "words": 27,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "1139688aca976e2dfa6117ef7131e6fe3990bf290790b5d881a9494dc18d71aa"
          }
        ]
      },
      {
        "start": 106.26666666666667,
        "end": 123.16666666666667,
        "cues": [
          {
            "text": "El resultado es 4 unidades de i griega subíndice 1 por unidades de i griega subíndice 2.",
            "start": 106.26666666666667,
            "end": 113.56666666666666,
            "startFrame": 3188,
            "endFrame": 3407,
            "words": 17,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "affd39635fc303c45afbf2aa29c936436b669b0c297566c646b830cc191a1c6b"
          },
          {
            "text": "El mínimo es menos 4; el máximo es más 4 y se alcanza con una relación lineal positiva exacta casi seguramente.",
            "start": 113.86666666666666,
            "end": 122.86666666666666,
            "startFrame": 3416,
            "endFrame": 3686,
            "words": 21,
            "sceneIndex": 8,
            "cueIndex": 1,
            "sourceCueSha256": "c045339835d537a24f5c787debab18ce6386dad1db0e290dc9b83ae358943498"
          }
        ]
      }
    ]
  },
