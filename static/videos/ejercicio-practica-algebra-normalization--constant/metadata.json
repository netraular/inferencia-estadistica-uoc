    "scenes": [
      {
        "start": 0,
        "end": 9.1,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Cuánto debe valer ce?",
            "start": 2.9,
            "end": 4.633333333333334,
            "startFrame": 87,
            "endFrame": 139,
            "words": 4,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "c346eca207809658dac9ed938a6d568fc485d88d001a91c91925c69e6e3e0a36"
          },
          {
            "text": "Queremos encontrar la constante que hace válida la distribución.",
            "start": 4.933333333333334,
            "end": 8.8,
            "startFrame": 148,
            "endFrame": 264,
            "words": 9,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "b40fe6d933998c22a7ce6408072557ad2263308712147c04d7872ace88ddf083"
          }
        ]
      },
      {
        "start": 9.1,
        "end": 22.9,
        "cues": [
          {
            "text": "Los pesos describen importancia relativa, no probabilidades todavía.",
            "start": 9.1,
            "end": 12.533333333333333,
            "startFrame": 273,
            "endFrame": 376,
            "words": 8,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "e33bfaa43d6e29ac4a8405b4023a154e8b3287c883e67e173ba8fa39d87a0ed4"
          },
          {
            "text": "Multiplicar todos por la misma constante conserva sus razones.",
            "start": 12.833333333333334,
            "end": 16.7,
            "startFrame": 385,
            "endFrame": 501,
            "words": 9,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "04558fd9b838befe14a002abfc3fdfe20fc2cd32a72e6cd0f977f5df6b98c0ec"
          },
          {
            "text": "Despejamos esa constante haciendo la misma operación en ambos lados de la igualdad.",
            "start": 17,
            "end": 22.6,
            "startFrame": 510,
            "endFrame": 678,
            "words": 13,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "09259802f8bd994869f33782c7049800cb7caab10126bdf5e085527f1963dc77"
          }
        ]
      },
      {
        "start": 22.9,
        "end": 24.933333333333334,
        "cues": [
          {
            "text": "Pesos: 2, 3, 7.",
            "start": 22.9,
            "end": 24.633333333333333,
            "startFrame": 687,
            "endFrame": 739,
            "words": 4,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "ccf4282bf8dad4c49200c293bd2159154d4ab3f132d787201d36d153f7a62c1f"
          }
        ]
      },
      {
        "start": 24.933333333333334,
        "end": 32.53333333333333,
        "cues": [
          {
            "text": "La igualdad es abre paréntesis, 2 más 3 más 7, cierra paréntesis por ce igual a 1.",
            "start": 24.933333333333334,
            "end": 32.233333333333334,
            "startFrame": 748,
            "endFrame": 967,
            "words": 17,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "5ad3cc6517360434d8f020c5a176d9bf55d55d836fefa15969415f184ea2ae8b"
          }
        ]
      },
      {
        "start": 32.53333333333333,
        "end": 36.7,
        "cues": [
          {
            "text": "Los pesos son positivos y no son aún proporciones.",
            "start": 32.53333333333333,
            "end": 36.4,
            "startFrame": 976,
            "endFrame": 1092,
            "words": 9,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "c793b7518bf9f464832b23ab6bd84412633617d9c7ac7eed128c7a67849aad8c"
          }
        ]
      },
      {
        "start": 36.7,
        "end": 40,
        "cues": [
          {
            "text": "La misma constante multiplica todos los pesos.",
            "start": 36.7,
            "end": 39.7,
            "startFrame": 1101,
            "endFrame": 1191,
            "words": 7,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "0f46c206827d04f323348dffb90832008ef5451257996cd232c070eddadb32a1"
          }
        ]
      },
      {
        "start": 40,
        "end": 51.766666666666666,
        "cues": [
          {
            "text": "Suma los pesos y divide ambos lados por ese total.",
            "start": 40,
            "end": 44.3,
            "startFrame": 1200,
            "endFrame": 1329,
            "words": 10,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "f36baeff243f23302ece03c0cbf0635c59e24cc927016e8b1794c4df8b59d9e8"
          },
          {
            "text": "Exigimos probabilidad total uno sobre todo el soporte y comprobamos además que no haya valores negativos.",
            "start": 44.6,
            "end": 51.46666666666667,
            "startFrame": 1338,
            "endFrame": 1544,
            "words": 16,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "338b797b05c2f943e489bfafeec59353192ac3c45bc57e311e268ecdf7203b96"
          }
        ]
      },
      {
        "start": 51.766666666666666,
        "end": 76.5,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 51.766666666666666,
            "end": 54.766666666666666,
            "startFrame": 1553,
            "endFrame": 1643,
            "words": 7,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "a3a9facd0d7e0e39df126691d21c1de17e3b3772c883acb32c3f895204dd4e94"
          },
          {
            "text": "¿Cuánto debe valer ce?",
            "start": 55.06666666666667,
            "end": 56.8,
            "startFrame": 1652,
            "endFrame": 1704,
            "words": 4,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "c0b895897320013d5c7ca174f68d75ffb8b6618361f42b99f79cbafc4093b0f6"
          },
          {
            "text": "La igualdad funciona como una balanza: hacemos la misma operación en ambos lados.",
            "start": 57.1,
            "end": 62.7,
            "startFrame": 1713,
            "endFrame": 1881,
            "words": 13,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "2eb36e324cd884ddb547609f3c8c9c31d5f221420428de35cf5a1efec1d97bd5"
          },
          {
            "text": "Primero sumamos los pesos y después dividimos ambos lados por esa suma para dejar sola la constante.",
            "start": 63,
            "end": 70.3,
            "startFrame": 1890,
            "endFrame": 2109,
            "words": 17,
            "sceneIndex": 7,
            "cueIndex": 3,
            "sourceCueSha256": "4fa2ba89dc2f8420b80a27479f1e8dc5530ded22b70a28616ad022f51759638d"
          },
          {
            "text": "Para este apartado: Suma los pesos y divide ambos lados por ese total.",
            "start": 70.6,
            "end": 76.2,
            "startFrame": 2118,
            "endFrame": 2286,
            "words": 13,
            "sceneIndex": 7,
            "cueIndex": 4,
            "sourceCueSha256": "ad1b0edb8003e816901dc4c677c97d20ac8e518973e01332bffc27bc5d877b7f"
          }
        ]
      },
      {
        "start": 76.5,
        "end": 84.96666666666667,
        "cues": [
          {
            "text": "Sumar primero. 2 más 3 más 7 igual a 12, por lo que 12 por ce igual a 1.",
            "start": 76.5,
            "end": 84.66666666666667,
            "startFrame": 2295,
            "endFrame": 2540,
            "words": 19,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "f31114f07ce9b6fcfc99333a9ca288a44b946f1023306bfb09dcfcf9f09fcb4c"
          }
        ]
      },
      {
        "start": 84.96666666666667,
        "end": 101.36666666666666,
        "cues": [
          {
            "text": "Hacer lo mismo en ambos lados.",
            "start": 84.96666666666667,
            "end": 87.56666666666666,
            "startFrame": 2549,
            "endFrame": 2627,
            "words": 6,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "502fbff8ee172ed9af0f524c81ea484784ac2abd45e9875b23b7768e1656ac3d"
          },
          {
            "text": "Dividimos ambos lados entre 12: ce igual a 1 dividido entre 12 igual a 0 coma 0 8 3 3 3 3 3 3.",
            "start": 87.86666666666666,
            "end": 98.16666666666667,
            "startFrame": 2636,
            "endFrame": 2945,
            "words": 24,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "eb9cbf5f99b9315c8784a95dcfc6ead23372c5e120840911b6c334bdf8487b0d"
          },
          {
            "text": "Si multiplicas por 12, recuperas uno.",
            "start": 98.46666666666667,
            "end": 101.06666666666666,
            "startFrame": 2954,
            "endFrame": 3032,
            "words": 6,
            "sceneIndex": 9,
            "cueIndex": 2,
            "sourceCueSha256": "160619d3425acdcc7fbd7c2b4d3ffbe80b1bdd51f5e66f59b7b8428022863c7f"
          }
        ]
      },
      {
        "start": 101.36666666666666,
        "end": 120.6,
        "cues": [
          {
            "text": "Comprobar e interpretar.",
            "start": 101.36666666666666,
            "end": 102.66666666666667,
            "startFrame": 3041,
            "endFrame": 3080,
            "words": 3,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "cf55d2dee61fecaefaf517d976559bb39558cb6d8cca4785a5a69cdccecd549a"
          },
          {
            "text": "El resultado es 0 coma 0 8 3 3 3 3 3 3 constante.",
            "start": 102.96666666666667,
            "end": 108.96666666666667,
            "startFrame": 3089,
            "endFrame": 3269,
            "words": 14,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "cd698fb9c86c00730e0128a0096a4ec9f10fa3d9c4c92961481b1828afbe3127"
          },
          {
            "text": "Revisamos que la respuesta use la unidad pedida y tenga sentido en el contexto.",
            "start": 109.26666666666667,
            "end": 115.26666666666667,
            "startFrame": 3278,
            "endFrame": 3458,
            "words": 14,
            "sceneIndex": 10,
            "cueIndex": 2,
            "sourceCueSha256": "ae30f7d81b2f013541a146ca2bc8212ed602a570ebb30cdb8272c3cf2878bbe8"
