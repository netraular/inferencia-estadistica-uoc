            "endFrame": 4538,
            "words": 36,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "2acfb8ab04d1a9b2c83767c9cec55c2a37e6a6f6d06dbd1ed07a5c6897ae9557"
          }
        ]
      },
      {
        "start": 151.56666666666666,
        "end": 172.33333333333334,
        "cues": [
          {
            "text": "Restar las acumuladas.",
            "start": 151.56666666666666,
