          },
          {
            "text": "Para este apartado: Suma toda la columna i griega igual a 1 y divide por el total.",
            "start": 88.03333333333333,
            "end": 95.33333333333333,
            "startFrame": 2641,
            "endFrame": 2860,
            "words": 17,
            "sceneIndex": 7,
            "cueIndex": 4,
