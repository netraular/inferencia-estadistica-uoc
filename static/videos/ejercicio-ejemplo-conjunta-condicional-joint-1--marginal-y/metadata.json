      },
      {
        "start": 130.76666666666668,
        "end": 150.03333333333333,
        "cues": [
          {
            "text": "Comprobar e interpretar.",
            "start": 130.76666666666668,
            "end": 132.06666666666666,
            "startFrame": 3923,
