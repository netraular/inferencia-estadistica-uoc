          }
        ]
      },
      {
        "start": 10.366666666666667,
        "end": 28.366666666666667,
        "cues": [
          {
            "text": "Cada celda de la conjunta representa dos valores del mismo resultado.",
            "start": 10.366666666666667,
            "end": 15.1,
            "startFrame": 311,
            "endFrame": 453,
            "words": 11,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "3f702495895226a07fcbc476e9e4210a70b35a622f15b3fdc7a1e50c22b9d29d"
          },
          {
            "text": "Sumar sobre la coordenada que descartamos produce una marginal.",
            "start": 15.4,
            "end": 19.266666666666666,
            "startFrame": 462,
            "endFrame": 578,
            "words": 9,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "d179f69456c855dcd1b6ae2f29bd995d8a3edb51fe3d9bd93119da517bf58848"
          },
          {
            "text": "Si fijamos una coordenada, dividimos por su marginal positiva para normalizar la condicional.",
            "start": 19.566666666666666,
            "end": 25.166666666666668,
            "startFrame": 587,
            "endFrame": 755,
            "words": 13,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "b519009337c9d4c5ebf6a45c29e91b421da0ad1198b905e1ad259e6a61c28d2d"
          },
          {
            "text": "No suponemos independencia de las coordenadas.",
            "start": 25.466666666666665,
            "end": 28.066666666666666,
            "startFrame": 764,
            "endFrame": 842,
            "words": 6,
            "sceneIndex": 1,
            "cueIndex": 3,
            "sourceCueSha256": "f3a0b63826844f6292a3cd1451eeef283234320558974f7c06ab7e1df4926c49"
          }
        ]
      },
      {
        "start": 28.366666666666667,
        "end": 36.4,
        "cues": [
          {
            "text": "Filas equis igual a 0 y 1; columnas i griega igual a 0 y 1; total 100 organismos.",
            "start": 28.366666666666667,
            "end": 36.1,
            "startFrame": 851,
            "endFrame": 1083,
            "words": 18,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "9c8c62ad457ed0c95f50ab7fd779a7fc25eee6ee09a4b5dfdd41d81b96c3eaa9"
          }
        ]
      },
      {
        "start": 36.4,
        "end": 46.56666666666667,
        "cues": [
          {
            "text": "Tabla de recuentos: equis igual a 0: intervalo cerrado desde 20 hasta 30; equis igual a 1: intervalo cerrado desde 20 hasta 30.",
            "start": 36.4,
            "end": 46.266666666666666,
            "startFrame": 1092,
            "endFrame": 1388,
            "words": 23,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "e60f059598dceb4d23b3efade8ff8df50c049dc989953141187b183dbe330609"
          }
        ]
      },
      {
        "start": 46.56666666666667,
        "end": 50.3,
        "cues": [
          {
            "text": "Cada organismo se selecciona con la misma probabilidad.",
            "start": 46.56666666666667,
            "end": 50,
            "startFrame": 1397,
            "endFrame": 1500,
            "words": 8,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "686e9d892969e91413d61cf85bdd956932aa9da069e2a43ae85124ea0c81a745"
          }
        ]
      },
      {
        "start": 50.3,
        "end": 54.46666666666667,
        "cues": [
          {
            "text": "No se supone independencia entre equis e i griega.",
            "start": 50.3,
            "end": 54.166666666666664,
            "startFrame": 1509,
            "endFrame": 1625,
            "words": 9,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "cad74c7d08fbfd336b07a6752ce2036221e227babb14d68479a861e5be781ad5"
          }
        ]
      },
      {
        "start": 54.46666666666667,
        "end": 67.06666666666666,
        "cues": [
          {
            "text": "Suma toda la columna i griega igual a 1 y divide por el total.",
            "start": 54.46666666666667,
            "end": 60.46666666666667,
            "startFrame": 1634,
            "endFrame": 1814,
            "words": 14,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "f57e76bde018c0f33225130a467070e04175140427068b42cb2ffaa46b48e995"
          },
          {
            "text": "Sumar o integrar sobre la coordenada descartada conserva todas sus posibilidades; no es condicionar.",
            "start": 60.766666666666666,
            "end": 66.76666666666667,
            "startFrame": 1823,
            "endFrame": 2003,
            "words": 14,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "c64ec8bf86b07bd9e034dbe3156a73c4e39765cd458a248940c5ed9cc3b08226"
          }
        ]
      },
      {
        "start": 67.06666666666666,
        "end": 95.63333333333334,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 67.06666666666666,
