            "end": 6.333333333333333,
            "startFrame": 87,
            "endFrame": 190,
            "words": 8,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "400abf5b40e82413ae1a3c7a76adf945f7c55d03e06c9dde48a8ec319c33b135"
          },
          {
            "text": "Queremos describir una variable sin fijar la otra.",
            "start": 6.633333333333334,
            "end": 10.066666666666666,
            "startFrame": 199,
            "endFrame": 302,
            "words": 8,
