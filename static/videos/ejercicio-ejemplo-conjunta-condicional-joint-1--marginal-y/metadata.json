          }
        ]
      },
      {
        "start": 95.63333333333334,
        "end": 106.66666666666667,
        "cues": [
          {
            "text": "Eliminar equis sumando. abre paréntesis, 30 más 30, cierra paréntesis dividido entre 100 igual a 0 coma 6. probabilidad de i griega igual a 1.",
            "start": 95.63333333333334,
            "end": 106.36666666666666,
            "startFrame": 2869,
            "endFrame": 3191,
            "words": 25,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "b7e3b37461c4852ac33913b3a2c48b2953a957f6fb720d8fe558432ca7bcb337"
          }
        ]
      },
      {
        "start": 106.66666666666667,
        "end": 118.13333333333334,
        "cues": [
          {
            "text": "probabilidad de i griega igual a 1 queda igual a suma para el índice abre paréntesis, equis minúscula, cierra paréntesis de probabilidad de abre paréntesis, equis.",
            "start": 106.66666666666667,
            "end": 117.83333333333333,
            "startFrame": 3200,
            "endFrame": 3535,
            "words": 26,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "560c6ff68f2b065ecda2b8b32f8645a1ea82fddcdbe5a7a718d6d8e04bb196e1"
          }
        ]
      },
      {
