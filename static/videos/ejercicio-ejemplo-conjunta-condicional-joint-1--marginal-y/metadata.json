            "end": 73.8,
            "startFrame": 2111,
            "endFrame": 2214,
            "words": 8,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "7bc5edd3989469b9c59c5399a972da9d31d89d392ad410e5e350baa91fc7c8be"
          },
          {
            "text": "Cada celda es una pareja simultánea.",
            "start": 74.1,
            "end": 76.7,
            "startFrame": 2223,
            "endFrame": 2301,
            "words": 6,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "e2801fd1402357ec73e430f3de0b0f8aeed1986f1564832b6df62e4a9918f9a5"
          },
          {
            "text": "Sumar una fila o columna elimina una variable y produce una marginal; dividir la celda por la marginal de la condición normaliza el subgrupo seleccionado.",
            "start": 77,
            "end": 87.73333333333333,
            "startFrame": 2310,
            "endFrame": 2632,
            "words": 25,
            "sceneIndex": 7,
            "cueIndex": 3,
