          }
        ]
      },
      {
        "start": 95.63333333333334,
        "end": 106.43333333333334,
        "cues": [
          {
            "text": "Probabilidad elemental.",
            "start": 95.63333333333334,
            "end": 96.83333333333333,
            "startFrame": 2869,
            "endFrame": 2905,
            "words": 2,
            "sceneIndex": 8,
