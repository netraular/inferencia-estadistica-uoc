          }
        ]
      },
      {
        "start": 28.033333333333335,
        "end": 39.5,
        "cues": [
          {
            "text": "probabilidad de A igual a 0 coma 3; probabilidad de be igual a 0 coma 6; probabilidad de A intersección be igual a 0 coma 1.",
