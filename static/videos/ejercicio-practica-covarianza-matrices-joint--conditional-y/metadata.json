            "end": 8.9,
            "startFrame": 87,
            "endFrame": 267,
            "words": 14,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "51889adaf4e52483174dffe1112671c3beea295c83aceac0f540c6705e8d350d"
