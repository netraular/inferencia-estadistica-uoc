          }
        ]
      },
      {
        "start": 39.833333333333336,
        "end": 50,
        "cues": [
          {
            "text": "Tabla de recuentos: equis igual a 0: intervalo cerrado desde 20 hasta 30; equis igual a 1: intervalo cerrado desde 10 hasta 40.",
