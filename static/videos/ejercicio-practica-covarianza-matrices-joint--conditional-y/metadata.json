        ]
      },
      {
        "start": 53.733333333333334,
        "end": 57.9,
        "cues": [
          {
            "text": "No se supone independencia entre equis e i griega.",
            "start": 53.733333333333334,
            "end": 57.6,
            "startFrame": 1612,
            "endFrame": 1728,
            "words": 9,
            "sceneIndex": 5,
