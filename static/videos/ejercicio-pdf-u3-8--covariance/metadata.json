            "sourceCueSha256": "f5b3ab4bc86e19a92bb497513098b78bfcb687cd4da698dbda752b6a3f33c090"
          },
          {
            "text": "Resto el producto de las medias de los indicadores.",
            "start": 121.43333333333334,
            "end": 125.3,
            "startFrame": 3643,
            "endFrame": 3759,
            "words": 9,
            "sceneIndex": 10,
            "cueIndex": 1,
