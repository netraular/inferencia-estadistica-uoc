          }
        ]
      },
      {
        "start": 79.46666666666667,
        "end": 83.63333333333334,
        "cues": [
          {
            "text": "Contar las recuperadas. 20 más 18 igual a 38.",
            "start": 79.46666666666667,
            "end": 83.33333333333333,
            "startFrame": 2384,
            "endFrame": 2500,
            "words": 9,
