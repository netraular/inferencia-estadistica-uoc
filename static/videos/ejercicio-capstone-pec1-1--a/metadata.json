            "startFrame": 2872,
            "endFrame": 2988,
            "words": 9,
            "sceneIndex": 8,
            "cueIndex": 1,
            "sourceCueSha256": "44f6ca6ca65416b12308734c706868542079797931e85820100216d75707f47e"
          },
          {
            "text": "El aviso permite que el portador de lunes sea cualquiera de los dos; no fija su identidad.",
