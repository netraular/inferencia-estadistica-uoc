        ]
      },
      {
        "start": 80.96666666666667,
        "end": 87.7,
        "cues": [
          {
            "text": "La elección ese del técnico es uniforme e independiente, anterior a observar genotipo y día.",
            "start": 80.96666666666667,
            "end": 87.4,
            "startFrame": 2429,
            "endFrame": 2622,
            "words": 15,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "afbcdc3de4ba4b2028b84d00402b1036d14a08e73d1f468e0f1f3c297bd70be7"
          }
        ]
      },
      {
        "start": 87.7,
        "end": 107.5,
        "cues": [
          {
            "text": "Llamo E a que se cumpla la pareja portador y lunes en el primero o en el segundo.",
            "start": 87.7,
            "end": 95.43333333333334,
            "startFrame": 2631,
            "endFrame": 2863,
            "words": 18,
            "sceneIndex": 8,
