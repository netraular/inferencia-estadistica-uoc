  "alignment": {
    "version": 1,
    "complete": true,
    "id": "calculo--pendiente-acumulada",
    "model": "gemini-3.8-flash-tts",
    "voice": "Puck",
    "cueTiming": "forced-aligned",
    "temporary": true,
    "listened": false,
