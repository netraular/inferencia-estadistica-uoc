          }
        ]
      },
      {
        "start": 153.86666666666667,
        "end": 161.46666666666667,
        "cues": [
          {
            "text": "pe abre paréntesis, 0 y menos 1, cierra paréntesis queda igual a 0 coma 1 2 5.",
