            "sourceCueSha256": "3ae37a8550e6db8846c5dcd06dbb128437054215e985622bdd48ff4c6d9b1ff7"
          },
          {
            "text": "La secuencia XXX produce el par de valores 0 y menos 1.",
            "start": 124.53333333333333,
            "end": 129.7,
            "startFrame": 3736,
            "endFrame": 3891,
            "words": 12,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "56b4263994c19db2db29ee86a3012d2ce316fa06b4e96cf3351e55d3470fec7b"
          },
          {
            "text": "No confundo una secuencia con su pareja de variables.",
            "start": 130,
            "end": 133.86666666666667,
            "startFrame": 3900,
            "endFrame": 4016,
            "words": 9,
            "sceneIndex": 9,
            "cueIndex": 2,
            "sourceCueSha256": "3800ac439ec2d992bdcac31c8ec7ad03b07ead49007e49c2a522bda2cee61248"
          }
        ]
      },
      {
        "start": 134.16666666666666,
        "end": 153.86666666666667,
        "cues": [
          {
            "text": "Acumular XXX.",
            "start": 134.16666666666666,
            "end": 135.36666666666667,
            "startFrame": 4025,
            "endFrame": 4061,
            "words": 2,
            "sceneIndex": 10,
