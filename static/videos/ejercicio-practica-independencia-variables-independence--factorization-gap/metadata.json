      },
      {
        "start": 20.233333333333334,
        "end": 37.03333333333333,
        "cues": [
          {
            "text": "Independencia exige factorizar toda la distribución conjunta en marginales.",
            "start": 20.233333333333334,
            "end": 24.1,
            "startFrame": 607,
            "endFrame": 723,
            "words": 9,
