            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "386ba43f75ba3bd0eca9c1bece4d55e483e5a3f3f207ab344ae8307b47ed92ed"
          }
        ]
      },
      {
        "start": 53.03333333333333,
        "end": 64.36666666666666,
        "cues": [
          {
            "text": "Infección y no infección forman una partición.",
            "start": 53.03333333333333,
            "end": 56.03333333333333,
            "startFrame": 1591,
            "endFrame": 1681,
            "words": 7,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "14764d66e6dd11f16e003b5f4de2063bf8470fc3f9d914e80e78ad7a42cbf9fd"
          },
          {
            "text": "Cada resultado tiene un único origen entre los considerados: las rutas se pueden sumar sin omisiones ni duplicados.",
            "start": 56.333333333333336,
            "end": 64.06666666666666,
            "startFrame": 1690,
            "endFrame": 1922,
            "words": 18,
            "sceneIndex": 5,
            "cueIndex": 1,
            "sourceCueSha256": "5ae1ba307a6adf33ecda840b92e5210abc783d80d31eb8a9e7fe9cb5211f3071"
          }
        ]
      },
      {
        "start": 64.36666666666666,
        "end": 72.4,
        "cues": [
          {
            "text": "Las características de la prueba son aplicables a esta población; no se supone independencia entre prueba e infección.",
            "start": 64.36666666666666,
            "end": 72.1,
            "startFrame": 1931,
            "endFrame": 2163,
            "words": 18,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "3993c39bba81fbada1342758047449877cafbeee8b35d12c35263ec63d293051"
          }
        ]
      },
      {
        "start": 72.4,
        "end": 84.6,
        "cues": [
          {
            "text": "Divide la probabilidad conjunta de infección y positivo por todos los positivos.",
            "start": 72.4,
            "end": 77.56666666666666,
            "startFrame": 2172,
            "endFrame": 2327,
            "words": 12,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "3d131ff1968407380a7b74dcaed70a8b9c3a2e3671bf281d552a47f7386ee9f1"
          },
          {
            "text": "La sensibilidad condiciona en el sentido contrario; Bayes cambia la referencia a todos los positivos.",
            "start": 77.86666666666666,
            "end": 84.3,
            "startFrame": 2336,
            "endFrame": 2529,
            "words": 15,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "c43c4ea00fa310b412427bb911102da86c941a3ced0e9a184339fcc1b9f93680"
          }
        ]
      },
      {
        "start": 84.6,
        "end": 118.2,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 84.6,
            "end": 87.6,
            "startFrame": 2538,
            "endFrame": 2628,
            "words": 7,
