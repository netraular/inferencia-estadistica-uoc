      },
      {
        "start": 42,
        "end": 53.03333333333333,
        "cues": [
          {
            "text": "Tasa de falsos positivos probabilidad de resultado positivo sabiendo que no i igual a 0 coma 0 5; especificidad igual a 0 coma 9 5.",
            "start": 42,
            "end": 52.733333333333334,
            "startFrame": 1260,
