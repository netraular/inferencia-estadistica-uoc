          },
          {
            "text": "La unión admite cualquiera de ellos; la intersección exige ambos.",
            "start": 17.133333333333333,
            "end": 21.433333333333334,
            "startFrame": 514,
            "endFrame": 643,
            "words": 10,
            "sceneIndex": 1,
            "cueIndex": 1,
