        ]
      },
      {
        "start": 55.7,
        "end": 74.33333333333333,
        "cues": [
          {
            "text": "Fronteras: y subíndice 1 igual a 2, y subíndice 2 igual a 0, y subíndice 2 igual a y subíndice 1 dividido entre 2.",
