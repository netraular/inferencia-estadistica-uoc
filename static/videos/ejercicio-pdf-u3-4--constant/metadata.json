            "cueIndex": 0,
            "sourceCueSha256": "f63b1f9e0d6890ff071c86fe7ab857d8518bf681368256b515f543407de0de8d"
          },
          {
            "text": "Al fijar una coordenada, la frontera determina el intervalo de la otra.",
            "start": 13.7,
            "end": 18.866666666666667,
            "startFrame": 411,
            "endFrame": 566,
            "words": 12,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "6d98d64f66ce3ab30c2bc7c848b2310a32c5d79e02ff0dffae96abc9814b787c"
          },
          {
            "text": "Integramos solo esos cortes.",
            "start": 19.166666666666668,
            "end": 20.9,
            "startFrame": 575,
            "endFrame": 627,
            "words": 4,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "9cd49477efad5fe66a3ff67b7aa1491c3ff956f347c20c8f70fdb4be21b42e47"
          },
          {
            "text": "Una densidad condicional divide por una marginal positiva, nunca por la probabilidad nula de un punto continuo.",
            "start": 21.2,
            "end": 28.5,
            "startFrame": 636,
            "endFrame": 855,
            "words": 17,
            "sceneIndex": 1,
            "cueIndex": 3,
            "sourceCueSha256": "5839ce4b45a37b8ed884e3b3c2836a7794be7698df4a2ab745141f175f1d8cc3"
          }
        ]
      },
      {
        "start": 28.8,
        "end": 55.7,
        "cues": [
          {
            "text": "efe minúscula abre paréntesis, i griega minúscula subíndice 1 ,i griega minúscula subíndice 2 , cierra paréntesis igual a ka si 0 menor o igual que y subíndice 1 menor o igual que 2, 0 menor o igual que y subíndice 2 menor o igual que 1 y 2 por y subíndice 2 menor o igual que y subíndice 1; cero fuera.",
