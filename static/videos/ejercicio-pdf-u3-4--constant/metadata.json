            "end": 74.03333333333333,
            "startFrame": 1989,
            "endFrame": 2221,
            "words": 18,
            "sceneIndex": 3,
            "cueIndex": 1,
            "sourceCueSha256": "cc38367802a0d986332b206f78a87a20cfbae5c678e4903978c9377ea7f9716a"
          }
        ]
      },
      {
        "start": 74.33333333333333,
        "end": 83.23333333333333,
        "cues": [
          {
            "text": "Se interpreta el objetivo matemático explícito i griega subíndice 1 mayor o igual que 3 por i griega subíndice 2.",
            "start": 74.33333333333333,
            "end": 82.93333333333334,
            "startFrame": 2230,
            "endFrame": 2488,
            "words": 20,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "53da80252c6326b5cc6b0b8d997c2d8e833e6543b295e5d79d0012214aee1d4b"
          }
        ]
      },
      {
        "start": 83.23333333333333,
        "end": 92.96666666666667,
        "cues": [
          {
            "text": "La descripción verbal del PDF de reducción de un tercio no equivale a esa desigualdad: su probabilidad sería uno en este soporte.",
