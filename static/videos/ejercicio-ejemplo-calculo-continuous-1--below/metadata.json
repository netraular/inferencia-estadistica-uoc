    "scenes": [
      {
        "start": 0,
        "end": 11.666666666666666,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "Calcula probabilidad de equis menor o igual que te minúscula.",
            "start": 2.9,
            "end": 7.2,
            "startFrame": 87,
            "endFrame": 216,
            "words": 10,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "31a4b074c72979d07eafb55ef75413bd7a4e4c32492299da2b54ec25a446a398"
          },
          {
            "text": "Queremos el área que queda por debajo del umbral.",
            "start": 7.5,
            "end": 11.366666666666667,
            "startFrame": 225,
            "endFrame": 341,
            "words": 9,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "b264eb6426f11e11e88b87754f171e03c38bca43cd25afe5b1a171e5fc77f194"
          }
        ]
      },
      {
        "start": 11.666666666666666,
        "end": 28.033333333333335,
        "cues": [
          {
            "text": "Una densidad es probabilidad por unidad, no probabilidad de un punto.",
            "start": 11.666666666666666,
            "end": 16.4,
            "startFrame": 350,
            "endFrame": 492,
            "words": 11,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "05d4efe578dbb94d081bb9622c4057e50cc4f2b1e5471faae321af144a49d26d"
          },
          {
            "text": "Su integral suma pequeñas áreas de altura por anchura.",
            "start": 16.7,
            "end": 20.566666666666666,
            "startFrame": 501,
            "endFrame": 617,
            "words": 9,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "3f297aeb4b5851aab819019a78ee0563797f31677a6427e0bc638b25dd980c2d"
          },
          {
            "text": "El soporte fija los límites permitidos y la normalización exige área uno y altura no negativa.",
            "start": 20.866666666666667,
            "end": 27.733333333333334,
            "startFrame": 626,
            "endFrame": 832,
            "words": 16,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "61a5a64822a3f83b31f98c11ef42aed07badf4c99a844b54c50e8f1d6bbb4545"
          }
        ]
      },
      {
        "start": 28.033333333333335,
        "end": 33.5,
        "cues": [
          {
            "text": "be igual a 3; umbral te minúscula igual a 1 coma 5.",
            "start": 28.033333333333335,
            "end": 33.2,
            "startFrame": 841,
            "endFrame": 996,
            "words": 12,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "a1d7b3441af350347796923cce084a1fe042543105f9ba2ee9f47ff339a3c470"
          }
        ]
      },
      {
        "start": 33.5,
        "end": 36.8,
        "cues": [
          {
            "text": "La densidad no es una probabilidad puntual.",
            "start": 33.5,
            "end": 36.5,
            "startFrame": 1005,
            "endFrame": 1095,
            "words": 7,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "279e84905e52328bc0a59b23ec5ebc9c84fca7a0c3caad072e9da0860f7ffa2a"
          }
        ]
      },
      {
        "start": 36.8,
        "end": 42.7,
        "cues": [
          {
            "text": "equis es continua y su soporte es intervalo cerrado desde 0 hasta be.",
            "start": 36.8,
            "end": 42.4,
            "startFrame": 1104,
            "endFrame": 1272,
            "words": 13,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "fecfe77dd1f176f77270ad2777ca14e94996b1bb86bbb9a182722abf077553e5"
          }
        ]
      },
      {
        "start": 42.7,
        "end": 47.733333333333334,
        "cues": [
          {
            "text": "La integral de la densidad sobre el soporte debe ser uno.",
            "start": 42.7,
            "end": 47.43333333333333,
            "startFrame": 1281,
            "endFrame": 1423,
            "words": 11,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "00a07a7cc2a6d98f5a2b767fa70da843253894404be5739d4d01cb285d68a846"
          }
        ]
      },
      {
        "start": 47.733333333333334,
        "end": 59.06666666666667,
        "cues": [
          {
            "text": "La probabilidad es el área desde cero hasta te minúscula.",
            "start": 47.733333333333334,
            "end": 52.03333333333333,
            "startFrame": 1432,
            "endFrame": 1561,
            "words": 10,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "a19598e47bee20c129d9bb4c43869032559959ae4d094204e89b1d7b0e34a9cc"
          },
          {
            "text": "Acumulamos desde el inicio del soporte y mantenemos las mismas unidades al introducir el límite.",
            "start": 52.333333333333336,
            "end": 58.766666666666666,
            "startFrame": 1570,
            "endFrame": 1763,
            "words": 15,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "bac8a048360aeb77013bcf2664326242e2e71fd0dff16854b507dc3721ab364c"
          }
        ]
      },
      {
        "start": 59.06666666666667,
        "end": 87.96666666666667,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 59.06666666666667,
            "end": 62.06666666666667,
            "startFrame": 1772,
            "endFrame": 1862,
            "words": 7,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "a3a9facd0d7e0e39df126691d21c1de17e3b3772c883acb32c3f895204dd4e94"
          },
          {
            "text": "Calcula probabilidad de equis menor o igual que te minúscula.",
            "start": 62.36666666666667,
            "end": 66.66666666666667,
            "startFrame": 1871,
            "endFrame": 2000,
            "words": 10,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "2068de4dd55ac4817d080441422d978de9762edf788f6d5ee3dcdec8479567ef"
          },
          {
            "text": "La probabilidad continua es un área.",
            "start": 66.96666666666667,
            "end": 69.56666666666666,
            "startFrame": 2009,
            "endFrame": 2087,
            "words": 6,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "f0e9fc153478029986e8c9b1b15243c248d6ea7b5dbfca761f782ef33e6c73e6"
          },
          {
            "text": "Una integral suma altura por anchura y una primitiva permite evaluar esa acumulación entre dos límites.",
            "start": 69.86666666666666,
            "end": 76.73333333333333,
            "startFrame": 2096,
            "endFrame": 2302,
            "words": 16,
            "sceneIndex": 7,
            "cueIndex": 3,
            "sourceCueSha256": "abd7b22a1f364aae5560b67b55bdbabe4a87e8c8eb3dec1a4559bbfb2bf6f03d"
          },
          {
            "text": "Normalizamos sobre todo el soporte antes de integrar la región solicitada.",
            "start": 77.03333333333333,
            "end": 81.76666666666667,
            "startFrame": 2311,
            "endFrame": 2453,
            "words": 11,
            "sceneIndex": 7,
            "cueIndex": 4,
            "sourceCueSha256": "addfd0f9010547f1b05252bc5b0d6faffc122838e296ab643f474f6d51cefb43"
          },
          {
            "text": "Para este apartado: La probabilidad es el área desde cero hasta te minúscula.",
            "start": 82.06666666666666,
            "end": 87.66666666666667,
            "startFrame": 2462,
            "endFrame": 2630,
            "words": 13,
            "sceneIndex": 7,
            "cueIndex": 5,
            "sourceCueSha256": "0ebaca7c06c2dbf04012bb165e53050b08e9cfe9050660db93f77e9abf01dcb1"
          }
        ]
      },
      {
        "start": 87.96666666666667,
        "end": 118.26666666666667,
        "cues": [
          {
            "text": "Integrar en el intervalo pedido. ce te minúscula al cuadrado dividido entre 2 igual a 0 coma 2 2 2 2 2 2 2 por 1 coma 5 elevado a abre paréntesis, 2, cierra paréntesis dividido entre 2 igual a 0 coma 2 5. probabilidad de equis menor o igual que te minúscula igual a integral desde 0 hasta te minúscula de ce por equis minúscula respecto de equis minúscula.",
            "start": 87.96666666666667,
            "end": 117.96666666666667,
            "startFrame": 2639,
            "endFrame": 3539,
            "words": 70,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "e2cfc2321bb2dd2705936bce36bd2c6b9cf66a685f97ad23802af80443bf9090"
          }
        ]
      },
      {
        "start": 118.26666666666667,
        "end": 144.4,
        "cues": [
          {
            "text": "Comprobar el área.",
            "start": 118.26666666666667,
            "end": 119.56666666666666,
            "startFrame": 3548,
            "endFrame": 3587,
            "words": 3,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "9c68ab23e50d9c0afcd24b93a924f5705ee4fe63398dc32ab4d51a7ff6d9a689"
          },
          {
            "text": "La primitiva de ce por equis minúscula es ce por equis minúscula al cuadrado dividido entre dos: su derivada vuelve a ser ce por equis minúscula.",
            "start": 119.86666666666666,
            "end": 131.03333333333333,
            "startFrame": 3596,
            "endFrame": 3931,
            "words": 26,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "513290edcf610ba1fb4d5752131d4be275b0a9a895ac1185afdcd03a77165a75"
          },
          {
            "text": "En cero vale cero; en 1 coma 5 vale 0 coma 2 5.",
            "start": 131.33333333333334,
            "end": 136.93333333333334,
            "startFrame": 3940,
            "endFrame": 4108,
            "words": 13,
            "sceneIndex": 9,
            "cueIndex": 2,
            "sourceCueSha256": "6f28318a01dbde721d9c525fc42f5f7dcfe92177170398406820dc65fefb0e1b"
          },
          {
            "text": "Restamos el valor inicial y obtenemos 0 coma 2 5, una probabilidad entre cero y uno.",
            "start": 137.23333333333332,
            "end": 144.1,
            "startFrame": 4117,
            "endFrame": 4323,
            "words": 16,
            "sceneIndex": 9,
            "cueIndex": 3,
            "sourceCueSha256": "10b4cc427e84ce0d786cb7b198fb01963159df5270ac51f0fc67d5c4c95b21bd"
          }
        ]
      },
      {
        "start": 144.4,
        "end": 169.23333333333332,
        "cues": [
          {
            "text": "Comprobar e interpretar.",
            "start": 144.4,
            "end": 145.7,
            "startFrame": 4332,
            "endFrame": 4371,
            "words": 3,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "cf55d2dee61fecaefaf517d976559bb39558cb6d8cca4785a5a69cdccecd549a"
          },
          {
            "text": "El resultado es 0 coma 2 5 probabilidad entre 0 y 1.",
            "start": 146,
            "end": 151.16666666666666,
            "startFrame": 4380,
            "endFrame": 4535,
            "words": 12,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "66243d7a663d2ab052353109f697ae66c29399be2b84e560f82ebc8a65b5d10c"
          },
          {
            "text": "Está entre cero y uno; si lo expresamos como porcentaje multiplicamos por cien, sin cambiar el suceso.",
            "start": 151.46666666666667,
            "end": 158.76666666666668,
            "startFrame": 4544,
            "endFrame": 4763,
