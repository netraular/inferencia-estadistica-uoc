            "endFrame": 4418,
            "words": 63,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "adf0784de5d6e09cdc1345ce42e09e0e3f8290b1484068459b8b2e58f2212d06"
          }
        ]
      },
      {
        "start": 147.56666666666666,
        "end": 166.06666666666666,
        "cues": [
          {
            "text": "Relacionar supervivencia y CDF.",
            "start": 147.56666666666666,
            "end": 149.3,
            "startFrame": 4427,
            "endFrame": 4479,
            "words": 4,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "b8468481243bb3dcd51a1ec26367c236ea455069bb8806942ed36bb45c6a8479"
          },
          {
            "text": "Haber perdido actividad antes del umbral y conservarla después son sucesos complementarios en este modelo continuo.",
            "start": 149.6,
            "end": 156.46666666666667,
            "startFrame": 4488,
            "endFrame": 4694,
            "words": 16,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "fd8a2a7cad15a6c4a2aad5182ec37f45aabe9b8a767c300e910dc6fc590bbdbb"
          },
          {
            "text": "Restar a uno la acumulada en 6 horas da la misma supervivencia, 0 coma 3 6 7 8 7 9 4.",
            "start": 156.76666666666668,
            "end": 165.76666666666668,
            "startFrame": 4703,
            "endFrame": 4973,
            "words": 21,
            "sceneIndex": 10,
