    "duration": 138,
    "scenes": [
      {
        "start": 0,
        "end": 11.7,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Qué proporción corresponde al último estado?",
            "start": 2.9,
            "end": 5.5,
            "startFrame": 87,
            "endFrame": 165,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "defec83aec959bc8f4af866e39bb74a3f18c87e0df6a8631955354125680fb27"
          },
          {
            "text": "Queremos comparar una parte con su propio total, no dar un recuento absoluto.",
            "start": 5.8,
            "end": 11.4,
            "startFrame": 174,
            "endFrame": 342,
            "words": 13,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "9d2d003a9fbe3398290d4830e52597de26915937790ca622e4322f780303f799"
          }
        ]
      },
      {
        "start": 11.7,
        "end": 25.5,
        "cues": [
          {
            "text": "Los pesos describen importancia relativa, no probabilidades todavía.",
            "start": 11.7,
            "end": 15.133333333333333,
            "startFrame": 351,
            "endFrame": 454,
            "words": 8,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "e33bfaa43d6e29ac4a8405b4023a154e8b3287c883e67e173ba8fa39d87a0ed4"
          },
          {
            "text": "Multiplicar todos por la misma constante conserva sus razones.",
            "start": 15.433333333333334,
            "end": 19.3,
            "startFrame": 463,
            "endFrame": 579,
            "words": 9,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "04558fd9b838befe14a002abfc3fdfe20fc2cd32a72e6cd0f977f5df6b98c0ec"
          },
          {
            "text": "Despejamos esa constante haciendo la misma operación en ambos lados de la igualdad.",
            "start": 19.6,
            "end": 25.2,
            "startFrame": 588,
            "endFrame": 756,
            "words": 13,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "09259802f8bd994869f33782c7049800cb7caab10126bdf5e085527f1963dc77"
          }
        ]
      },
      {
        "start": 25.5,
        "end": 27.533333333333335,
        "cues": [
          {
            "text": "Pesos: 2, 3, 7.",
            "start": 25.5,
            "end": 27.233333333333334,
            "startFrame": 765,
            "endFrame": 817,
            "words": 4,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "ccf4282bf8dad4c49200c293bd2159154d4ab3f132d787201d36d153f7a62c1f"
          }
        ]
      },
      {
        "start": 27.533333333333335,
        "end": 35.13333333333333,
        "cues": [
          {
            "text": "La igualdad es abre paréntesis, 2 más 3 más 7, cierra paréntesis por ce igual a 1.",
            "start": 27.533333333333335,
            "end": 34.833333333333336,
            "startFrame": 826,
            "endFrame": 1045,
            "words": 17,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "5ad3cc6517360434d8f020c5a176d9bf55d55d836fefa15969415f184ea2ae8b"
          }
        ]
      },
      {
        "start": 35.13333333333333,
        "end": 39.3,
        "cues": [
          {
            "text": "Los pesos son positivos y no son aún proporciones.",
            "start": 35.13333333333333,
            "end": 39,
            "startFrame": 1054,
            "endFrame": 1170,
            "words": 9,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "c793b7518bf9f464832b23ab6bd84412633617d9c7ac7eed128c7a67849aad8c"
          }
        ]
      },
      {
        "start": 39.3,
        "end": 42.6,
        "cues": [
          {
            "text": "La misma constante multiplica todos los pesos.",
            "start": 39.3,
            "end": 42.3,
            "startFrame": 1179,
            "endFrame": 1269,
            "words": 7,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "0f46c206827d04f323348dffb90832008ef5451257996cd232c070eddadb32a1"
          }
        ]
      },
      {
        "start": 42.6,
        "end": 50.53333333333333,
        "cues": [
          {
            "text": "Multiplica el último peso por ce.",
            "start": 42.6,
            "end": 45.2,
            "startFrame": 1278,
            "endFrame": 1356,
            "words": 6,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "b7d24b1a65cc19c21e982996830a86dbb83aef40a88671e39e2186a8b82bea00"
          },
          {
            "text": "Dividir por el total conserva la importancia relativa de esa parte.",
            "start": 45.5,
            "end": 50.233333333333334,
            "startFrame": 1365,
            "endFrame": 1507,
            "words": 11,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "3bbf9fcb6a9705f39fbd48af37cdedfeaff3011f842d42ad16703e04d6dd8763"
          }
        ]
      },
      {
        "start": 50.53333333333333,
        "end": 74.4,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 50.53333333333333,
            "end": 53.53333333333333,
            "startFrame": 1516,
            "endFrame": 1606,
            "words": 7,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "a3a9facd0d7e0e39df126691d21c1de17e3b3772c883acb32c3f895204dd4e94"
          },
          {
            "text": "¿Qué proporción corresponde al último estado?",
            "start": 53.833333333333336,
            "end": 56.43333333333333,
            "startFrame": 1615,
            "endFrame": 1693,
            "words": 6,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "0e5ada86f03cec6b31f253cec40ffd4fbdcb55d67ac645ad0b5063a200eebe82"
          },
          {
            "text": "La igualdad funciona como una balanza: hacemos la misma operación en ambos lados.",
            "start": 56.733333333333334,
            "end": 62.333333333333336,
            "startFrame": 1702,
            "endFrame": 1870,
            "words": 13,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "d8d7e5d590381d2d7ef0ad2de523c3c4d088d4b2d256fe4830efbffbd0180f5f"
          },
          {
            "text": "Primero sumamos los pesos y después dividimos ambos lados por esa suma para dejar sola la constante.",
            "start": 62.63333333333333,
            "end": 69.93333333333334,
            "startFrame": 1879,
            "endFrame": 2098,
            "words": 17,
            "sceneIndex": 7,
            "cueIndex": 3,
            "sourceCueSha256": "eafa39cca99cf50c4e6ebc80486b3d1d0ee4bf2cf907e03cd9f9e977aa2fcc04"
          },
          {
            "text": "Para este apartado: Multiplica el último peso por ce.",
            "start": 70.23333333333333,
            "end": 74.1,
            "startFrame": 2107,
            "endFrame": 2223,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 4,
            "sourceCueSha256": "9d390051115ff9029fc5debc58c3de1ac64ce6b259768c1afe7be9207aa7d9e1"
          }
        ]
      },
      {
        "start": 74.4,
        "end": 85,
        "cues": [
          {
            "text": "Escalar el peso. 7 por abre paréntesis, 1 dividido entre 12, cierra paréntesis igual a 0 coma 5 8 3 3 3 3 3.",
            "start": 74.4,
            "end": 84.7,
            "startFrame": 2232,
            "endFrame": 2541,
            "words": 24,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "1f658ecf5262ff14ac417d5c327506b75d36919bf47b851fcdf9f6badf7fbdbd"
          }
        ]
      },
      {
        "start": 85,
        "end": 102.66666666666667,
        "cues": [
          {
            "text": "Revisar el total.",
            "start": 85,
            "end": 86.3,
            "startFrame": 2550,
            "endFrame": 2589,
            "words": 3,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "51eb5e0532292562261bc6c68c82f870630f7dbbde9d8e2fb1f467c6f5b7f90c"
          },
          {
            "text": "Las tres proporciones son 0 coma 1 6 6 6 6 6 7, 0 coma 2 5, 0 coma 5 8 3 3 3 3 3.",
            "start": 86.6,
            "end": 97.76666666666667,
            "startFrame": 2598,
            "endFrame": 2933,
            "words": 26,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "3b3f6d2c8c093678708190856fd5d9ffe9f4394f996ecc602e8b63fe790a1915"
          },
          {
            "text": "Sin redondear, suman 12 dividido entre 12 igual a 1.",
            "start": 98.06666666666666,
            "end": 102.36666666666666,
            "startFrame": 2942,
            "endFrame": 3071,
            "words": 10,
            "sceneIndex": 9,
            "cueIndex": 2,
            "sourceCueSha256": "0b238a5563d394c913cc2f8c7cda3f2806cc15b6801355fcbc19c4cdaa7673d9"
          }
        ]
      },
      {
        "start": 102.66666666666667,
        "end": 124.93333333333334,
        "cues": [
          {
            "text": "Comprobar e interpretar.",
            "start": 102.66666666666667,
            "end": 103.96666666666667,
            "startFrame": 3080,
            "endFrame": 3119,
            "words": 3,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "cf55d2dee61fecaefaf517d976559bb39558cb6d8cca4785a5a69cdccecd549a"
          },
          {
            "text": "El resultado es 0 coma 5 8 3 3 3 3 3 probabilidad entre 0 y 1.",
            "start": 104.26666666666667,
            "end": 111.56666666666666,
            "startFrame": 3128,
            "endFrame": 3347,
            "words": 17,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "dd889b3be2245c5840e0d6d0011e668d6d442271ddd293524b4dde294faa98e4"
          },
          {
            "text": "Está entre cero y uno; si lo expresamos como porcentaje multiplicamos por cien, sin cambiar el suceso.",
            "start": 111.86666666666666,
            "end": 119.16666666666667,
            "startFrame": 3356,
            "endFrame": 3575,
            "words": 17,
            "sceneIndex": 10,
            "cueIndex": 2,
            "sourceCueSha256": "aa1d6d19c420ba9dcb2f5309dd1375dbb5f320164532f736c28fa346126dcc40"
          },
          {
            "text": "Dividir todos los pesos por el mismo total conserva su importancia relativa.",
            "start": 119.46666666666667,
            "end": 124.63333333333334,
            "startFrame": 3584,
            "endFrame": 3739,
            "words": 12,
            "sceneIndex": 10,
            "cueIndex": 3,
            "sourceCueSha256": "137cf053901f0221b6f3686b77a937be9520478cf83a8e2185bbda1c96dd1872"
          }
        ]
      },
      {
        "start": 124.93333333333334,
        "end": 138,
        "cues": [
          {
            "text": "El resultado es 0 coma 5 8 3 3 3 3 3 probabilidad entre 0 y 1.",
            "start": 124.93333333333334,
            "end": 132.23333333333332,
            "startFrame": 3748,
            "endFrame": 3967,
            "words": 17,
            "sceneIndex": 11,
            "cueIndex": 0,
            "sourceCueSha256": "81f72e5511523112dc9111e5ddb019954c4f7a3646f81e6193808024a55c80d1"
          },
