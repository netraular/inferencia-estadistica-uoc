            "sourceCueSha256": "788ce25ec39c172e1ed760800fd13f3586fdef806ad95b4b3e0aa18e299c9135"
          },
          {
            "text": "Fuera de cero a uno no hay soporte.",
            "start": 150.93333333333334,
            "end": 154.36666666666667,
            "startFrame": 4528,
            "endFrame": 4631,
            "words": 8,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "84e3261e98080a41a2cb2bea9123930827d712cc35415cbe0da2637fa8129d9e"
          }
        ]
      },
      {
        "start": 154.66666666666666,
        "end": 177.26666666666668,
        "cues": [
          {
            "text": "Integrar la cola. i griega dos mayor que medio selecciona la parte alta del triángulo. probabilidad de i griega subíndice 2 mayor que 0 coma 5 igual a integral desde 0 coma 5 hasta 1 de abre paréntesis, 2 menos 2 por y subíndice 2, cierra paréntesis respecto de y subíndice 2.",
            "start": 154.66666666666666,
            "end": 176.96666666666667,
            "startFrame": 4640,
            "endFrame": 5309,
            "words": 52,
