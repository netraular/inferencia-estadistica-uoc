          },
          {
            "text": "¿Qué probabilidad tiene i griega subíndice 2 mayor que 0 coma 5?",
            "start": 2.9,
            "end": 8.066666666666666,
            "startFrame": 87,
            "endFrame": 242,
            "words": 12,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "2a28e215c98dc3e88479f9c2f03de54918637df6c6ddc59a7fd5f331caf67300"
          },
          {
            "text": "Queremos describir una variable sin fijar la otra.",
            "start": 8.366666666666667,
