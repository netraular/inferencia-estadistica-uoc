            "startFrame": 3242,
            "endFrame": 3872,
            "words": 49,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "d8fda6c315f16c060217db3b410974b11790474b17666cac1771bd57e6400b2d"
          }
        ]
      },
      {
        "start": 129.36666666666667,
        "end": 162.76666666666668,
        "cues": [
          {
            "text": "Cancelar el tiempo transcurrido.",
            "start": 129.36666666666667,
            "end": 131.1,
            "startFrame": 3881,
            "endFrame": 3933,
            "words": 4,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "56f170eaf2e61ece3eb716af4525b7337b8248b05e3bb072cc458e8ade603a7b"
          },
          {
            "text": "Al dividir exponenciales de la misma base restamos exponentes.",
            "start": 131.4,
            "end": 135.26666666666668,
            "startFrame": 3942,
            "endFrame": 4058,
            "words": 9,
            "sceneIndex": 9,
            "cueIndex": 1,
            "sourceCueSha256": "b04c639c9deabc1e256ab66d8615c456fd2435ae16c92da14d42a5aa441af7cd"
          },
          {
            "text": "El término del tiempo ya transcurrido se cancela: queda exponencial de abre paréntesis, menos 0 coma 2 5 por 3, cierra paréntesis igual a 0 coma 4 7 2 3 6 6 6.",
            "start": 135.56666666666666,
            "end": 149.73333333333332,
            "startFrame": 4067,
            "endFrame": 4492,
            "words": 33,
            "sceneIndex": 9,
            "cueIndex": 2,
            "sourceCueSha256": "27a5288e3da911055f0b9edfed42435d08836e1e2c8c729f896eaa6143b106ec"
          },
          {
            "text": "Solo interviene la espera adicional. probabilidad de te mayor que te minúscula más ese sabiendo que te mayor que te minúscula igual a probabilidad de te mayor que ese.",
            "start": 150.03333333333333,
            "end": 162.46666666666667,
            "startFrame": 4501,
