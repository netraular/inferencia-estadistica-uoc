          }
        ]
      },
      {
        "start": 33.1,
        "end": 37.7,
        "cues": [
          {
            "text": "Estudio de 300 pacientes; cada individuo presenta una única variante.",
            "start": 33.1,
            "end": 37.4,
            "startFrame": 993,
            "endFrame": 1122,
            "words": 10,
