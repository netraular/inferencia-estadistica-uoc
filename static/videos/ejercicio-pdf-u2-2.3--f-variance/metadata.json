          }
        ]
      },
      {
        "start": 95.06666666666666,
        "end": 107.26666666666667,
        "cues": [
          {
            "text": "Para los cuadrados, una integración por partes reduce la potencia.",
            "start": 95.06666666666666,
            "end": 99.36666666666666,
            "startFrame": 2852,
