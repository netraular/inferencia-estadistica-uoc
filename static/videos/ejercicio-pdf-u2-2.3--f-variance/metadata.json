          },
          {
            "text": "El segundo momento incluye la posición del centro; restar el cuadrado de la media deja solo dispersión.",
            "start": 99.66666666666667,
            "end": 106.96666666666667,
            "startFrame": 2990,
            "endFrame": 3209,
            "words": 17,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "420cf772b1e403752b96d74bf5a10bc58ca4b4b1e65bbf6cc1e6e8296d79c1e9"
          }
        ]
      },
      {
        "start": 107.26666666666667,
        "end": 117.76666666666667,
        "cues": [
          {
            "text": "E entre corchetes significa esperanza.",
            "start": 107.26666666666667,
            "end": 109.43333333333334,
            "startFrame": 3218,
            "endFrame": 3283,
            "words": 5,
