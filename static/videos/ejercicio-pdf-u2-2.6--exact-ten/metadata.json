          }
        ]
      },
      {
        "start": 72.93333333333334,
        "end": 83,
        "cues": [
          {
            "text": "El coeficiente binomial cuenta subconjuntos o posiciones sin orden.",
            "start": 72.93333333333334,
            "end": 76.8,
            "startFrame": 2188,
            "endFrame": 2304,
            "words": 9,
            "sceneIndex": 7,
