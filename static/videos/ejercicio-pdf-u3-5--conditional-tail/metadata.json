          }
        ]
      },
      {
        "start": 59.96666666666667,
        "end": 75.7,
        "cues": [
          {
            "text": "Se pide probabilidad de i griega subíndice 2 mayor que 0 coma 5 y probabilidad de i griega subíndice 1 mayor que 1 coma 5 sabiendo que i griega subíndice 2 igual a 0 coma 5.",
            "start": 59.96666666666667,
