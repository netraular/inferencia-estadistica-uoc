          }
        ]
      },
      {
        "start": 75.7,
        "end": 80.73333333333333,
        "cues": [
          {
            "text": "Se usa ka igual a 1 obtenido en el ejercicio 4.",
            "start": 75.7,
            "end": 80.43333333333334,
            "startFrame": 2271,
            "endFrame": 2413,
            "words": 11,
            "sceneIndex": 4,
