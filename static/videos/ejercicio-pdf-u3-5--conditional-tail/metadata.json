            "startFrame": 3454,
            "endFrame": 3969,
            "words": 40,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "48b8dda18b7ec4aa24a033ef90f18e945aa8e9e5e5e19f72ff48f38487f5e544"
          }
        ]
      },
      {
        "start": 132.6,
        "end": 141.9,
        "cues": [
          {
            "text": "efe subíndice abre paréntesis, i griega subíndice 2, cierra paréntesis abre paréntesis, 0 coma 5, cierra paréntesis queda igual a 1.",
