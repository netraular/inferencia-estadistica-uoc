            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Cuál es probabilidad de i griega subíndice 1 mayor que 1 coma 5 sabiendo que i griega subíndice 2 igual a 0 coma 5?",
            "start": 2.9,
            "end": 13.2,
            "startFrame": 87,
