            "startFrame": 2859,
            "endFrame": 2924,
            "words": 5,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "8ee34fc56d3a638cb0a0c83dd04c53a513d8cb10110bebd33863fc326b0d13a3"
          },
          {
            "text": "La frontera inclinada obliga a y uno entre uno y dos. 2 por 0 coma 5 igual a 1 por tanto 1 menor o igual que y subíndice 1 menor o igual que 2.",
