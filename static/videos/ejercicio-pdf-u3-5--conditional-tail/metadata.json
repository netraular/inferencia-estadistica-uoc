          }
        ]
      },
      {
        "start": 93.26666666666667,
        "end": 112.66666666666667,
        "cues": [
          {
            "text": "Fijar el corte condicional.",
            "start": 93.26666666666667,
            "end": 95,
            "startFrame": 2798,
            "endFrame": 2850,
            "words": 4,
            "sceneIndex": 6,
            "cueIndex": 0,
