          }
        ]
      },
      {
        "start": 80.73333333333333,
        "end": 93.26666666666667,
        "cues": [
          {
            "text": "Sustituyo y dos por medio.",
            "start": 80.73333333333333,
            "end": 82.9,
            "startFrame": 2422,
            "endFrame": 2487,
            "words": 5,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "548ab256de3798f5517f9bf9d0556df34518e3e5255fdb5ff943e7af40772222"
          },
          {
            "text": "La frontera inclinada obliga a y uno entre uno y dos.",
            "start": 83.2,
            "end": 87.93333333333334,
            "startFrame": 2496,
            "endFrame": 2638,
            "words": 11,
            "sceneIndex": 5,
            "cueIndex": 1,
            "sourceCueSha256": "4d88651b701e7d1742a7a24b839671b1578adcc742a4df58d1904fd76704c021"
          },
          {
            "text": "Normalizamos dentro de la condición; una marginal no incorpora esa información.",
