      },
      {
        "start": 183.6,
        "end": 192.8,
        "cues": [
          {
            "text": "Completar la definición.",
            "start": 183.6,
            "end": 184.9,
            "startFrame": 5508,
            "endFrame": 5547,
            "words": 3,
            "sceneIndex": 10,
