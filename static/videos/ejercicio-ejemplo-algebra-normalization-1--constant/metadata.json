            "sourceCueSha256": "cf55d2dee61fecaefaf517d976559bb39558cb6d8cca4785a5a69cdccecd549a"
          },
          {
            "text": "El resultado es 0 coma 1 1 1 1 1 1 1 constante.",
            "start": 102.53333333333333,
            "end": 108.13333333333334,
            "startFrame": 3076,
            "endFrame": 3244,
            "words": 13,
            "sceneIndex": 10,
