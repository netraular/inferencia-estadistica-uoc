    "canonicalSha256": "42294a61ec3f09e6db5611c1e948f9507213a3abf29ff0de2b24240ad61f857a",
    "duration": 69.48,
    "mp3Sha256": "4b15eadff3495f895422354b27d245080b1455f3b082eef0052a399b7be0bf53",
    "mp3Bytes": 834669,
    "scenes": [
      {
        "start": 0.3325,
        "end": 69.13250000000001,
        "cues": [
          {
            "sceneIndex": 0,
            "cueIndex": 0,
            "text": "Hola.",
            "start": 0.3325,
            "end": 0.4925,
            "score": -0.3752276808372699,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 1,
            "text": "Comprobemos el factor una décima en el estado de peso cinco: su probabilidad, pe sub tres, es cinco por una décima.",
            "start": 1.2325,
            "end": 9.0125,
            "score": -1.2569574061781168,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 2,
            "text": "Volver a los datos originales es la manera de verificar el despeje.",
            "start": 9.9325,
            "end": 12.8125,
            "score": -0.12098849874455482,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 3,
            "text": "Cinco de diez es una mitad: ese estado recibe la mitad de la probabilidad total.",
            "start": 13.8525,
            "end": 18.1525,
            "score": -0.06335090229840716,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 4,
            "text": "Los pesos dos y tres reciben dos décimas y tres décimas, sin cambiar sus proporciones relativas.",
            "start": 19.3125,
            "end": 24.5925,
            "score": -0.15193871298106387,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 5,
            "text": "Dos décimas más tres décimas más cinco décimas completan uno; la comprobación satisface justo la condición que originó nuestra ecuación.",
            "start": 25.9125,
            "end": 33.072500000000005,
            "score": -1.6044725930052144,
            "needsReview": true
          },
          {
            "sceneIndex": 0,
            "cueIndex": 6,
            "text": "Falta otra comprobación: ninguna masa puede ser negativa.",
            "start": 34.5525,
            "end": 37.572500000000005,
            "score": -0.11308688364700477,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 7,
            "text": "Resolver una ecuación no basta si el resultado queda fuera del dominio del problema; aquí todas son no negativas.",
            "start": 38.6325,
            "end": 44.712500000000006,
            "score": -0.11132942762924358,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 8,
            "text": "Tres al cuadrado significa multiplicar tres por sí mismo y da nueve, no sumar tres dos veces.",
            "start": 46.3725,
            "end": 51.99250000000001,
            "score": -0.21033135056495667,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 9,
            "text": "Las potencias serán útiles cuando midamos distancias cuadradas.",
            "start": 52.932500000000005,
            "end": 55.5525,
            "score": -0.11058729637564586,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 10,
            "text": "La raíz cuadrada de nueve devuelve tres por convenio no negativo.",
            "start": 57.0525,
            "end": 60.5125,
            "score": -0.1640021757533153,
            "needsReview": false
          },
          {
            "sceneIndex": 0,
            "cueIndex": 11,
            "text": "Aunque menos tres también tiene cuadrado nueve, una desviación típica mide tamaño, y por eso elegiremos la raíz no negativa.",
            "start": 61.3325,
            "end": 69.13250000000001,
            "score": -0.3667021647905296,
            "needsReview": false
          }
        ]
      }
    ],
