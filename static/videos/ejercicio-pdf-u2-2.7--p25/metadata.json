            "cueIndex": 0,
            "sourceCueSha256": "c70b9fc2ebad15e9750dd7a836cfd2d86d2a18be1fd821e412d4133c860352e7"
          }
        ]
      },
      {
        "start": 126.93333333333334,
        "end": 152.43333333333334,
        "cues": [
          {
            "text": "Recuperar la escala.",
            "start": 126.93333333333334,
            "end": 128.23333333333332,
            "startFrame": 3808,
            "endFrame": 3847,
            "words": 3,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "f6250ee599e3bb722e7de6b60ab57b20e1bc1b073b2adb673a8b37fa36c28efa"
          },
          {
            "text": "Multiplico zeta por sigma, la desviación típica, para volver a las unidades originales. 8 por menos 0 coma 6 7 4 4 8 9 7 5 0 1 9 6 0 8 1 8 igual a menos 5 coma 3 9 5 9 1 8 0 0 1 5 6 8 6 5 4 5.",
            "start": 128.53333333333333,
            "end": 152.13333333333333,
            "startFrame": 3856,
            "endFrame": 4564,
            "words": 55,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "ceb56e8b11269e88548fd336fa9a477eb6313076de777e7c00f92f65454245c0"
          }
        ]
      },
      {
        "start": 152.43333333333334,
        "end": 169.33333333333334,
        "cues": [
          {
            "text": "Recuperar el centro.",
            "start": 152.43333333333334,
            "end": 153.73333333333332,
            "startFrame": 4573,
            "endFrame": 4612,
            "words": 3,
            "sceneIndex": 11,
            "cueIndex": 0,
            "sourceCueSha256": "304311eae62148403130643140487d72e915efbfb33fe360a253e6cf2a9b5c30"
          },
          {
            "text": "Sumo mu, la media, al desplazamiento obtenido. ce igual a 106 más abre paréntesis, menos 5 coma 3 9 5 9 1 8 0 0 1 5 6 8 6 5 4 5, cierra paréntesis.",
            "start": 154.03333333333333,
            "end": 169.03333333333333,
            "startFrame": 4621,
            "endFrame": 5071,
            "words": 35,
            "sceneIndex": 11,
            "cueIndex": 1,
            "sourceCueSha256": "53cf6ee8e201eb8088a266d2bd9d15bdd4824eecbc0fc6015ee23daa238d8946"
