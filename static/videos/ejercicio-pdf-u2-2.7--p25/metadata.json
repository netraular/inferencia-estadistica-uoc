        ]
      },
      {
        "start": 169.33333333333334,
        "end": 178.23333333333332,
        "cues": [
          {
            "text": "ce queda igual a 100 coma 6 0 4 0 8 1 9 9 8 4 3 1 3 4.",
            "start": 169.33333333333334,
            "end": 177.93333333333334,
            "startFrame": 5080,
            "endFrame": 5338,
            "words": 20,
