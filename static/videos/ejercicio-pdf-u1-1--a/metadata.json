          }
        ]
      },
      {
        "start": 70.53333333333333,
        "end": 84.76666666666667,
        "cues": [
          {
            "text": "Quitar el duplicado.",
            "start": 70.53333333333333,
            "end": 71.83333333333333,
            "startFrame": 2116,
