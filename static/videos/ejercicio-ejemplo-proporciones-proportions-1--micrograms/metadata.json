    "canonicalSha256": "12e9a9645540ace2f3b5ff54bd70bf5f448806a4393ead87b45b656b07e29fd9",
    "timing": {
      "wordsPerMinute": 140,
      "pauseSeconds": 0.3,
      "minimumCueSeconds": 1.2
    },
    "duration": 110.86666666666666,
    "scenes": [
      {
        "start": 0,
        "end": 11.233333333333333,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
            "cueIndex": 0,
            "sourceCueSha256": "8586fca739b63ef74da218c127714f71629ba791147b7f6563f99bea49d9b641"
          },
          {
            "text": "¿Cuántos microgramos son la cantidad de nutriente indicada?",
            "start": 2.9,
            "end": 6.333333333333333,
            "startFrame": 87,
            "endFrame": 190,
            "words": 8,
            "sceneIndex": 0,
            "cueIndex": 1,
            "sourceCueSha256": "639ba5c7b0968464e5ec7d6e1a1ddee2516e3cb6f5ff82a1991b0b64d2dbfe2c"
          },
          {
            "text": "Queremos expresar la misma masa en una unidad más pequeña.",
            "start": 6.633333333333334,
            "end": 10.933333333333334,
            "startFrame": 199,
            "endFrame": 328,
            "words": 10,
            "sceneIndex": 0,
            "cueIndex": 2,
            "sourceCueSha256": "e0ffc44a5caded548d7cf5df33ccc6840419a184ff2a3bb1ee207f4c6ab7386e"
          }
        ]
      },
      {
        "start": 11.233333333333333,
        "end": 26.3,
        "cues": [
          {
            "text": "Una proporción divide la parte por el total al que pertenece.",
            "start": 11.233333333333333,
            "end": 15.966666666666667,
            "startFrame": 337,
            "endFrame": 479,
            "words": 11,
            "sceneIndex": 1,
            "cueIndex": 0,
            "sourceCueSha256": "7afcb52b5a25efc34290b9b5455e104973d1f4261e18072295a66eb7ec8ecb4d"
          },
          {
            "text": "El porcentaje multiplica esa proporción por cien.",
            "start": 16.266666666666666,
            "end": 19.266666666666666,
            "startFrame": 488,
            "endFrame": 578,
            "words": 7,
            "sceneIndex": 1,
            "cueIndex": 1,
            "sourceCueSha256": "56aba128c1e151c16e02f1e012a0db5e9143592207a46858797e4d5f066e8b35"
          },
          {
            "text": "Para cambiar unidades multiplicamos por una equivalencia que vale uno físicamente, conservando la cantidad medida.",
            "start": 19.566666666666666,
            "end": 26,
            "startFrame": 587,
            "endFrame": 780,
            "words": 15,
            "sceneIndex": 1,
            "cueIndex": 2,
            "sourceCueSha256": "7f516cc3357456e9ec56eab10cbf14395048b4bb8b9635572fab4cf320563de7"
          }
        ]
      },
      {
        "start": 26.3,
        "end": 29.6,
        "cues": [
          {
            "text": "Se siembran 40 semillas y germinan 20.",
            "start": 26.3,
            "end": 29.3,
            "startFrame": 789,
            "endFrame": 879,
            "words": 7,
            "sceneIndex": 2,
            "cueIndex": 0,
            "sourceCueSha256": "857a6ddbeb0be1ab7f3dce1b32b55af6b475c74b29a953027cfa71b84964afac"
          }
        ]
      },
      {
        "start": 29.6,
        "end": 34.63333333333333,
        "cues": [
          {
            "text": "Se pesan 2 miligramos de nutriente; un miligramo contiene 1000 microgramos.",
            "start": 29.6,
            "end": 34.333333333333336,
            "startFrame": 888,
            "endFrame": 1030,
            "words": 11,
            "sceneIndex": 3,
            "cueIndex": 0,
            "sourceCueSha256": "379c3edc6e8957a3aa84f8a314b1ee47edf96f3411161b22abf7f53b032364de"
          }
        ]
      },
      {
        "start": 34.63333333333333,
        "end": 38.36666666666667,
        "cues": [
          {
            "text": "Las semillas germinadas forman parte de las sembradas.",
            "start": 34.63333333333333,
            "end": 38.06666666666667,
            "startFrame": 1039,
            "endFrame": 1142,
            "words": 8,
            "sceneIndex": 4,
            "cueIndex": 0,
            "sourceCueSha256": "fb621b158505dab3f1e2e802851ae1dd5e1e2f0296ae44a31545cf61695e57cc"
          }
        ]
      },
      {
        "start": 38.36666666666667,
        "end": 43.4,
        "cues": [
          {
            "text": "Cambiar la unidad de masa no cambia la cantidad de nutriente.",
            "start": 38.36666666666667,
            "end": 43.1,
            "startFrame": 1151,
            "endFrame": 1293,
            "words": 11,
            "sceneIndex": 5,
            "cueIndex": 0,
            "sourceCueSha256": "b11666d22980529273834164eb23afbda16ef0c0d14a311be62eecb131275daa"
          }
        ]
      },
      {
        "start": 43.4,
        "end": 52.6,
        "cues": [
          {
            "text": "Cada miligramo equivale a mil microgramos.",
            "start": 43.4,
            "end": 46,
            "startFrame": 1302,
            "endFrame": 1380,
            "words": 6,
            "sceneIndex": 6,
            "cueIndex": 0,
            "sourceCueSha256": "d6f4483dad2c0c33631941c3cc77c0426506a898778d2b3eb00fe44896feaa6d"
          },
          {
            "text": "El factor de conversión multiplica el número de unidades, no la cantidad de nutriente.",
            "start": 46.3,
            "end": 52.3,
            "startFrame": 1389,
            "endFrame": 1569,
            "words": 14,
            "sceneIndex": 6,
            "cueIndex": 1,
            "sourceCueSha256": "30db2d2d48bd98f0d5061d38b7d6b44aa8057d19a0e177107e3b5632c46de2a8"
          }
        ]
      },
      {
        "start": 52.6,
        "end": 78.03333333333333,
        "cues": [
          {
            "text": "Identificar la pregunta y justificar el método.",
            "start": 52.6,
            "end": 55.6,
            "startFrame": 1578,
            "endFrame": 1668,
            "words": 7,
            "sceneIndex": 7,
            "cueIndex": 0,
            "sourceCueSha256": "a3a9facd0d7e0e39df126691d21c1de17e3b3772c883acb32c3f895204dd4e94"
          },
          {
            "text": "¿Cuántos microgramos son la cantidad de nutriente indicada?",
            "start": 55.9,
            "end": 59.333333333333336,
            "startFrame": 1677,
            "endFrame": 1780,
            "words": 8,
            "sceneIndex": 7,
            "cueIndex": 1,
            "sourceCueSha256": "17f3093cc66d1b57ff9c3f7114b3276ba87cdcfd5ad2e1a33dc202f4a5fe0053"
          },
          {
            "text": "Una proporción compara una parte con su propio total.",
            "start": 59.63333333333333,
            "end": 63.5,
            "startFrame": 1789,
            "endFrame": 1905,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 2,
            "sourceCueSha256": "bd4838584e2b7eb3bd1221723dbc578647510416190d2f18ab7cd684e2605cae"
          },
          {
            "text": "Dividir conserva la comparación; multiplicar por cien solo cambia su escritura a porcentaje.",
            "start": 63.8,
            "end": 69.4,
            "startFrame": 1914,
            "endFrame": 2082,
            "words": 13,
            "sceneIndex": 7,
            "cueIndex": 3,
            "sourceCueSha256": "940857d6e79beae58da1fdff49a83eeb2680fe305ebe817e472560295a11fcd3"
          },
          {
            "text": "En una conversión de unidades conservamos la cantidad física.",
            "start": 69.7,
            "end": 73.56666666666666,
            "startFrame": 2091,
            "endFrame": 2207,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 4,
            "sourceCueSha256": "e81869ad6663e70c198f740460a3a7b896aec175a49c532f2bdf8c18cdbc273d"
          },
          {
            "text": "Para este apartado: Cada miligramo equivale a mil microgramos.",
            "start": 73.86666666666666,
            "end": 77.73333333333333,
            "startFrame": 2216,
            "endFrame": 2332,
            "words": 9,
            "sceneIndex": 7,
            "cueIndex": 5,
            "sourceCueSha256": "a293b8dec85873332b73943403f9ea179008cf5ca8f79f6110c20b3c58c669ba"
          }
        ]
      },
      {
        "start": 78.03333333333333,
        "end": 85.53333333333333,
        "cues": [
          {
            "text": "Elegir el factor.",
            "start": 78.03333333333333,
            "end": 79.33333333333333,
            "startFrame": 2341,
            "endFrame": 2380,
            "words": 3,
            "sceneIndex": 8,
            "cueIndex": 0,
            "sourceCueSha256": "9e6ea87f0b085d02969e11b489935f82d2c82fe9ced0997d9accecac3a032201"
          },
          {
            "text": "Pasamos a una unidad mil veces más pequeña: necesitamos mil veces más unidades.",
            "start": 79.63333333333334,
            "end": 85.23333333333333,
            "startFrame": 2389,
            "endFrame": 2557,
            "words": 13,
            "sceneIndex": 8,
            "cueIndex": 1,
            "sourceCueSha256": "10aed89057e11b9618ec8c7aecb88d975976f62099fbac5515ff06c7f73136f7"
          }
        ]
      },
      {
        "start": 85.53333333333333,
        "end": 90.56666666666666,
        "cues": [
          {
            "text": "Multiplicar conservando la cantidad. 2 por 1000 igual a 2000 microgramos.",
            "start": 85.53333333333333,
            "end": 90.26666666666667,
            "startFrame": 2566,
            "endFrame": 2708,
            "words": 11,
            "sceneIndex": 9,
            "cueIndex": 0,
            "sourceCueSha256": "608631e13d1b21ee712307a5acbf4f6cb6442935e3ae9c84fa9109131ea03ecf"
          }
        ]
      },
      {
        "start": 90.56666666666666,
        "end": 104.66666666666667,
        "cues": [
          {
            "text": "Comprobar e interpretar.",
            "start": 90.56666666666666,
            "end": 91.86666666666666,
            "startFrame": 2717,
            "endFrame": 2756,
            "words": 3,
            "sceneIndex": 10,
            "cueIndex": 0,
            "sourceCueSha256": "cf55d2dee61fecaefaf517d976559bb39558cb6d8cca4785a5a69cdccecd549a"
          },
          {
            "text": "El resultado es 2000 microgramos.",
            "start": 92.16666666666667,
            "end": 94.33333333333333,
            "startFrame": 2765,
            "endFrame": 2830,
            "words": 5,
            "sceneIndex": 10,
            "cueIndex": 1,
            "sourceCueSha256": "68bc9d9c7aeb05070424a6bb3d3cd1032d30719ca8b18650fad468b920d319a5"
          },
          {
            "text": "Revisamos que la respuesta use la unidad pedida y tenga sentido en el contexto.",
            "start": 94.63333333333334,
            "end": 100.63333333333334,
            "startFrame": 2839,
            "endFrame": 3019,
            "words": 14,
            "sceneIndex": 10,
            "cueIndex": 2,
            "sourceCueSha256": "ad25228bf90bed4827d889916b9376b32234d117202777d0c9cb911fb0e63f96"
          },
          {
            "text": "El número aumenta, pero no hemos añadido nutriente.",
            "start": 100.93333333333334,
            "end": 104.36666666666666,
            "startFrame": 3028,
            "endFrame": 3131,
            "words": 8,
            "sceneIndex": 10,
            "cueIndex": 3,
            "sourceCueSha256": "020b4ee520a0e6149fe148622a4f420fd9b9346065496e3c0059fac6d713a510"
          }
        ]
      },
      {
        "start": 104.66666666666667,
        "end": 110.86666666666666,
        "cues": [
          {
            "text": "El resultado es 2000 microgramos.",
            "start": 104.66666666666667,
            "end": 106.83333333333333,
            "startFrame": 3140,
            "endFrame": 3205,
            "words": 5,
            "sceneIndex": 11,
            "cueIndex": 0,
            "sourceCueSha256": "2d94e558696d4ce0b55adafef23fcd1a51c55ab9d67c67f38a4160375c796f2d"
          },
          {
