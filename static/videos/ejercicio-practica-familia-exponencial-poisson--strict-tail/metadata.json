            "sourceCueSha256": "3396ff1dd2413c4f508509c4bce1e6fc1637cfcce036b22020f6449c05b9cf6d"
          },
          {
            "text": "Las masas excluidas son, aproximadamente, 0 coma 0 0 2 4 7 8 7 5 2 más 0 coma 0 1 4 8 7 2 5 1 más 0 coma 0 4 4 6 1 7 5 4 más 0 coma 0 8 9 2 3 5 0 8.",
            "start": 111.93333333333334,
            "end": 132.93333333333334,
            "startFrame": 3358,
            "endFrame": 3988,
            "words": 49,
            "sceneIndex": 9,
            "cueIndex": 1,
