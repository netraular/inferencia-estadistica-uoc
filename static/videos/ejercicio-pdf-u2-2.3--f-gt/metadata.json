    "scenes": [
      {
        "start": 0,
        "end": 12.533333333333333,
        "cues": [
          {
            "text": "Vamos a resolver este apartado juntos.",
            "start": 0,
            "end": 2.6,
            "startFrame": 0,
            "endFrame": 78,
            "words": 6,
            "sceneIndex": 0,
